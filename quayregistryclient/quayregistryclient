def fetch_catalog_v2(registry_url, username, password,Port,token=None):
    """Fetch the registry catalog, following the pagination Link headers.

    The token is optional: when it is None the request is sent anonymously.
    Returns a dict like {"repositories": [...]}, or None on failure.
    """
    if debug:
        printstderr("# fetch_catalog_v2")
    if checkhttpsconnection(registry_url,Port)==0:
        return None

    # username/password are kept in the signature for backward compatibility;
    # authentication is carried by the Bearer token only.
    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
    }
    if token is not None:
        headers['Authorization'] = "Bearer "+token

    url_short=_base_url(registry_url, Port)
    url=url_short+"/v2/_catalog"

    if debug:
        log_python_request_curl_transform("GET",url,headers)

    response = requests.get(url, headers=headers)
    if response.status_code != 200:
        printstderr(f"Failed to get images: {response.status_code}")
        return None

    try:
        images = json.loads(response.text)
    except json.JSONDecodeError:
        printstderr("Failed to parse JSON response")
        return None

    while "Link" in response.headers:
        next_re = re.search(r'<(.*)>', response.headers["Link"])
        if not next_re:
            break
        url = url_short + next_re.group(1)
        response = requests.get(url, headers=headers)
        if response.status_code != 200:
            printstderr(f"Failed to get next images: {response.status_code}")
            break
        images_next = json.loads(response.text)
        images["repositories"] = images["repositories"] + images_next.get("repositories", [])

    return images


