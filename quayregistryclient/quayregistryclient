_complete_repositories() {
    local registry="$1"
    local port="$2"
    local token="$3"
    local username="$4"
    local password="$5"
    local repos

    if [[ -z "${token}" ]]; then
        token=$(_get_token "${registry}" "${port}" "${username}" "${password}")
    fi

    if [[ -z "${token}" ]]; then
        echo "Error: No token available. Provide -T token or configure ~/.docker/config.json" >&2
        COMPREPLY=()
        return 1
    fi

    # SECURITY: the token is passed through the ENVIRONMENT, not the python3
    # command line (a command line is world-readable in `ps`).
    repos=$(QRC_COMPL_TOKEN="${token}" QRC_COMPL_REGISTRY="${registry}" \
            QRC_COMPL_PORT="${port}" python3 -c '
import os, requests, json, sys
try:
    headers = {"Authorization": "Bearer " + os.environ["QRC_COMPL_TOKEN"]}
    url = "https://%s:%s/v2/_catalog" % (os.environ["QRC_COMPL_REGISTRY"], os.environ["QRC_COMPL_PORT"])
    response = requests.get(url, headers=headers, timeout=5)
    if response.status_code == 200:
        data = json.loads(response.text)
        print(" ".join(data.get("repositories", [])))
    else:
        sys.exit(1)
except Exception:
    sys.exit(1)
' 2>&1)

    if [[ $? -eq 0 && -n "${repos}" ]]; then
        COMPREPLY=( $(compgen -W "${repos}" -- "${cur}") )
    else
        echo "Error: Failed to fetch repositories from ${registry}:${port}" >&2
        COMPREPLY=()
    fi
}

_complete_tags() {
    local registry="$1"
    local port="$2"
    local image="$3"
    local token="$4"
    local username="$5"
    local password="$6"
    local tags

    if [[ -z "${token}" ]]; then
        token=$(_get_token "${registry}" "${port}" "${username}" "${password}")
    fi

    if [[ -z "${token}" ]]; then
        echo "Error: No token available. Provide -T token or configure ~/.docker/config.json" >&2
        COMPREPLY=()
        return 1
    fi

    # SECURITY: token + image via the environment, never the command line
    # (also immune to a repo name containing quotes).
    tags=$(QRC_COMPL_TOKEN="${token}" QRC_COMPL_REGISTRY="${registry}" \
            QRC_COMPL_PORT="${port}" QRC_COMPL_IMAGE="${image}" python3 -c '
import os, requests, json, sys
try:
    headers = {"Authorization": "Bearer " + os.environ["QRC_COMPL_TOKEN"]}
    url = "https://%s:%s/v2/%s/tags/list" % (os.environ["QRC_COMPL_REGISTRY"],
                                             os.environ["QRC_COMPL_PORT"],
                                             os.environ["QRC_COMPL_IMAGE"])
    response = requests.get(url, headers=headers, timeout=5)
    if response.status_code == 200:
        data = json.loads(response.text)
        print(" ".join(data.get("tags", [])))
    else:
        sys.exit(1)
except Exception:
    sys.exit(1)
' 2>&1)

    if [[ $? -eq 0 && -n "${tags}" ]]; then
        COMPREPLY=( $(compgen -W "${tags}" -- "${cur}") )
    else
        echo "Error: Failed to fetch tags for ${image} from ${registry}:${port}" >&2
        COMPREPLY=()
    fi
}

_get_token() {
    local registry="$1"
    local port="$2"
    local username="$3"
    local password="$4"

    # 1. An explicit API/registry token wins (same variable as the tool).
    if [[ -n "${QRC_TOKEN:-}" ]]; then
        echo "${QRC_TOKEN}"
        return 0
    fi

    # 2. Credentials from the environment, then from the credential stores,
    #    in the same order as lookup_credentials() in the tool.
    username="${username:-${QRC_USERNAME:-}}"
    password="${password:-${QRC_PASSWORD:-}}"

    if [[ -z "${username}" || -z "${password}" ]]; then
        local candidate creds
        for candidate in "${REGISTRY_AUTH_FILE:-}" \
                         "${XDG_RUNTIME_DIR:-}/containers/auth.json" \
                         "${HOME}/.config/containers/auth.json" \
                         "${HOME}/.docker/config.json"; do
            [[ -n "${candidate}" && -f "${candidate}" ]] || continue
            # SECURITY: path + registry via the environment, not the command line.
            creds=$(QRC_COMPL_CONFIG="${candidate}" QRC_COMPL_REGISTRY="${registry}" \
                    QRC_COMPL_PORT="${port}" python3 -c '
import os, json, base64, sys
try:
    with open(os.environ["QRC_COMPL_CONFIG"], "r") as f:
        config = json.load(f)
    auths = config.get("auths", {})
    registry = os.environ["QRC_COMPL_REGISTRY"]
    port = os.environ["QRC_COMPL_PORT"]
    for key in [registry + ":" + port, registry, "https://" + registry, "http://" + registry]:
        if key in auths:
            auth_data = auths[key]
            if "auth" in auth_data:
                decoded = base64.b64decode(auth_data["auth"]).decode("utf-8")
                if ":" in decoded:
                    print(decoded)
                    sys.exit(0)
            if "username" in auth_data and "password" in auth_data:
                print(auth_data["username"] + ":" + auth_data["password"])
                sys.exit(0)
except Exception:
    pass
sys.exit(1)
' 2>/dev/null)
            if [[ $? -eq 0 && -n "${creds}" ]]; then
                username="${creds%%:*}"
                password="${creds#*:}"
                break
            fi
        done
    fi

    if [[ -n "${username}" && -n "${password}" ]]; then
        # SECURITY: credentials via the environment, never the command line.
        # service= WITHOUT the port, matching getToken() (Quay advertises the
        # service without it); Basic encoded in UTF-8 like podman.
        QRC_COMPL_USER="${username}" QRC_COMPL_PASS="${password}" \
            QRC_COMPL_REGISTRY="${registry}" QRC_COMPL_PORT="${port}" python3 -c '
import os, requests, json, sys, base64
from urllib.parse import urlencode
try:
    user = os.environ["QRC_COMPL_USER"]
    registry = os.environ["QRC_COMPL_REGISTRY"]
    port = os.environ["QRC_COMPL_PORT"]
    raw = ("%s:%s" % (user, os.environ["QRC_COMPL_PASS"])).encode("utf-8")
    headers = {"Content-Type": "application/json", "Accept": "application/json",
               "Authorization": "Basic " + base64.b64encode(raw).decode("ascii")}
    options = {"account": user, "service": registry}
    url = "https://%s:%s/v2/auth?" % (registry, port) + urlencode(options)
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        data = json.loads(response.text)
        print(data.get("token", ""))
except Exception:
    sys.exit(1)
' 2>/dev/null
    fi
}

complete -F _quayregistryclient quayregistryclient
'''
    print(completion_script)


