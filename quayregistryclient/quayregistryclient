def _apply_subcommand_help(subparsers):
    """Give every sub-command a description and per-option help text."""
    for name, sp in subparsers.choices.items():
        sp.description = SUBCOMMAND_DESCRIPTIONS.get(name, '')
        for action in sp._actions:
            if action.dest in OPTION_HELP and not action.help:
                action.help = OPTION_HELP[action.dest]


