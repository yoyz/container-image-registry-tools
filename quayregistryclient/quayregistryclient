class TreeNode:
    def __init__(self, name, node_type, parent=None, data=None):
        self.name = name
        self.node_type = node_type
        self.parent = parent
        self.data = data
        self.children = []
        self.expanded = False
        self.loaded = False


class QueryLoop:
    def __init__(self, registry_url, port, username, password, debug=False,
                 anonymous=False):
        self.registry_url = registry_url
        self.port = port
        self.username = username
        self.password = password
        self.debug = debug
        self.anonymous = anonymous
        self.token = None
        self.root = None
        self.visible_nodes = []
        self.selected_idx = 0
        self.search_term = ""
        self.search_active = False
        self.search_matches = []
        self.current_match = 0
        # Keep-alive HTTP session for the UI thread. The helpers below use
        # _http_session(), which is thread-local, so the background tag-count
        # workers get their own connection without sharing this one.
        self.session = _http_session()
        # Per-session caches: a node is loaded once and the data is reused by
        # the renderer, the details view and the size calculation.
        self._catalog = None
        self._tags_cache = {}
        self._digest_cache = {}
        self._manifest_cache = {}
        self._repo_info_cache = {}
        # Tag counts are fetched in the background so the first paint and every
        # keypress never wait for the network. Daemon workers are used on
        # purpose: quitting must not wait for an in-flight HTTP request.
        self._tag_counts = {}
        self._tag_count_pending = set()
        self._tag_count_updated = threading.Event()
        self._tag_count_queue = queue.Queue()
        self._tag_workers = []

    def authenticate(self):
        if self.anonymous:
            # No credential to check. fetch_catalog() tries an anonymous
            # service token, then falls back to a plain unauthenticated GET.
            return True
        if not self.username or not self.password:
            return False
        try:
            self.token = getToken(self.registry_url, self.username, self.password, self.port)
            return True
        except (Exception, SystemExit):
            return False

    def fetch_catalog(self):
        if self._catalog is not None:
            return self._catalog
        if not self.authenticate():
            return []
        if self.anonymous and not self.token:
            # Some registries issue a service token without credentials but
            # still refuse /v2/_catalog without it. Ignore refusal: an open
            # registry serves the catalog without any token.
            self.token, _ttl = _get_anonymous_token(self.registry_url, self.port)
        try:
            images = fetch_catalog_v2(self.registry_url, self.username, self.password, self.port, self.token)
            if images and "repositories" in images:
                self._catalog = sorted(images["repositories"])
            else:
                self._catalog = []
        except (Exception, SystemExit):
            self._catalog = []
        return self._catalog

    def fetch_tags(self, repo_name):
        if repo_name in self._tags_cache:
            return self._tags_cache[repo_name]
        if not self.token and not self.anonymous:
            if not self.authenticate():
                return []
        try:
            token2 = getTokenForImageScope(self.registry_url, self.username, self.password, self.port, repo_name, anonymous=self.anonymous)
            tags_data = get_tag_image(self.registry_url, self.username, self.password, self.port, token2, repo_name)
            tags = (tags_data.get("tags") or []) if tags_data else []
        except (Exception, SystemExit):
            return []
        self._tags_cache[repo_name] = tags
        self._tag_counts[repo_name] = len(tags)
        return tags

    def fetch_digest(self, repo_name, tag):
        key = (repo_name, tag)
        if key in self._digest_cache:
            return self._digest_cache[key]
        if not self.token and not self.anonymous:
            return None
        try:
            token2 = getTokenForImageScope(self.registry_url, self.username, self.password, self.port, repo_name, anonymous=self.anonymous)
            digest = get_manifest_list_image_digest(self.registry_url, self.username, self.password, self.port, token2, repo_name, tag)
        except (Exception, SystemExit):
            return None
        self._digest_cache[key] = digest
        return digest

    def fetch_image_info(self, repo_name):
        if repo_name in self._repo_info_cache:
            return self._repo_info_cache[repo_name]
        if not self.token:
            if not self.authenticate():
                return None
        try:
            headers = {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'Authorization': "Bearer " + self.token
            }
            url = f"https://{self.registry_url}:{self.port}/api/v1/repository/{repo_name}"
            response = self.session.get(url, headers=headers, timeout=10)
            if response.status_code == 200:
                self._repo_info_cache[repo_name] = response.json()
                return self._repo_info_cache[repo_name]
            return None
        except Exception:
            return None

    def format_size(self, size_bytes):
        if size_bytes is None:
            return "?"
        for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
            if size_bytes < 1024:
                return f"{size_bytes:.1f}{unit}"
            size_bytes /= 1024
        return f"{size_bytes:.1f}PB"

    def format_date(self, date_str):
        if not date_str:
            return "?"
        try:
            from datetime import datetime
            dt = datetime.fromisoformat(date_str.replace('Z', '+00:00'))
            return dt.strftime("%Y-%m-%d")
        except:
            return date_str[:10] if date_str else "?"

    def search_nodes(self, term):
        if not term:
            self.search_matches = []
            return
        self.search_matches = []
        for i, (node, depth) in enumerate(self.visible_nodes):
            if self._node_matches_term(node, term):
                self.search_matches.append(i)
        self.current_match = 0

    def _node_matches_term(self, node, term):
        search_name = node.name.lower()
        if term.lower() in search_name:
            return True
        if node.node_type == "image" and node.data and "repo" in node.data:
            if term.lower() in node.data["repo"].lower():
                return True
        return False

    def _expand_matching_paths(self, node, term):
        if node.node_type in ("directory", "registry"):
            if not node.expanded:
                node.expanded = True
                self.load_node_children(node)
            for child in node.children:
                if self._expand_matching_paths(child, term):
                    return True
            return False
        elif node.node_type == "image":
            return self._node_matches_term(node, term)
        return False

    def _expand_only_matching_paths(self, term):
        repos = self.fetch_catalog()
        if not repos:
            return
        term_lower = term.lower()
        matching_repos = [r for r in repos if term_lower in r.lower()]
        for repo in matching_repos:
            parts = repo.split('/')
            current = self.root
            for part in parts:
                if not current.expanded:
                    current.expanded = True
                    self.load_node_children(current)
                found = False
                for child in current.children:
                    if child.node_type == "directory" and part + "/" == child.name:
                        current = child
                        found = True
                        break
                    elif child.node_type == "image" and (part == child.name or part == child.data.get("repo", "")):
                        found = True
                        break
                if not found:
                    break

    def get_search_input(self, stdscr):
        stdscr.timeout(-1)
        h, w = stdscr.getmaxyx()
        input_str = ""
        cursor_pos = 0
        while True:
            stdscr.addstr(h - 2, 0, " " * (w - 1))
            stdscr.addstr(h - 2, 0, f"Search: {input_str}_")
            stdscr.refresh()
            key = stdscr.getch()
            if key == ord('\n') or key == ord('\r'):
                break
            elif key in (ord('\x7f'), 127, curses.KEY_BACKSPACE, 8):
                if cursor_pos > 0:
                    input_str = input_str[:cursor_pos - 1] + input_str[cursor_pos:]
                    cursor_pos -= 1
            elif key == 27:
                return ""
            elif 32 <= key <= 126:
                if cursor_pos < 40:
                    input_str = input_str[:cursor_pos] + chr(key) + input_str[cursor_pos:]
                    cursor_pos += 1
        return input_str

    def search_all_repos(self, term):
        if not term:
            self.search_matches = []
            return
        visible = self.get_visible_nodes()
        self.search_matches = []
        for i, (node, depth) in enumerate(visible):
            if term.lower() in node.name.lower():
                self.search_matches.append(i)
        self.current_match = 0

    def calculate_image_size(self, repo_name):
        if not self.token:
            return None
        try:
            tags = self.fetch_tags(repo_name)
            if not tags:
                return None
            total_size = 0
            for tag in tags[:3]:
                digest = self.fetch_digest(repo_name, tag)
                if not digest:
                    continue
                manifest = self.fetch_manifest(repo_name, digest)
                if not manifest:
                    continue
                if manifest.get("schemaVersion") == 2:
                    media_type = manifest.get("mediaType", "")
                    if "manifest.list" in media_type or "image.index" in media_type:
                        for m in manifest.get("manifests", []):
                            m_digest = m.get("digest", "")
                            if m_digest:
                                m_manifest = self.fetch_manifest(repo_name, m_digest)
                                if m_manifest:
                                    if "config" in m_manifest:
                                        total_size += m_manifest.get("config", {}).get("size", 0)
                                    if "layers" in m_manifest:
                                        for layer in m_manifest.get("layers", []):
                                            total_size += layer.get("size", 0)
                    else:
                        if "config" in manifest:
                            total_size += manifest.get("config", {}).get("size", 0)
                        if "layers" in manifest:
                            for layer in manifest.get("layers", []):
                                total_size += layer.get("size", 0)
            return total_size if total_size > 0 else None
        except Exception:
            return None

    def fetch_manifest(self, repo_name, digest):
        key = (repo_name, digest)
        if key in self._manifest_cache:
            return self._manifest_cache[key]
        if not self.token and not self.anonymous:
            return None
        try:
            token2 = getTokenForImageScope(self.registry_url, self.username, self.password, self.port, repo_name, anonymous=self.anonymous)
            manifest = get_manifestlist(self.registry_url, self.username, self.password, self.port, token2, repo_name, digest)
            parsed = json.loads(manifest) if manifest else None
        except (Exception, SystemExit):
            return None
        self._manifest_cache[key] = parsed
        return parsed

    def request_tag_count(self, repo_name):
        """Fetch an image's tag count in the background (never blocks the UI)."""
        if not repo_name or repo_name in self._tag_counts \
                or repo_name in self._tag_count_pending:
            return
        if not self._tag_workers:
            for _ in range(6):
                worker = threading.Thread(target=self._tag_count_worker,
                                          name="qrc-tag-count", daemon=True)
                worker.start()
                self._tag_workers.append(worker)
        self._tag_count_pending.add(repo_name)
        self._tag_count_queue.put(repo_name)

    def _tag_count_worker(self):
        while True:
            repo_name = self._tag_count_queue.get()
            try:
                if repo_name is None:
                    return
                count = len(self.fetch_tags(repo_name) or [])
            except (Exception, SystemExit):
                count = 0
            finally:
                self._tag_count_queue.task_done()
            self._tag_count_pending.discard(repo_name)
            self._tag_counts[repo_name] = count
            self._tag_count_updated.set()

    def close(self):
        # Unblock the daemon workers; they are daemons so exit never waits on
        # a slow registry.
        for _ in self._tag_workers:
            self._tag_count_queue.put(None)
        try:
            self.session.close()
        except Exception:
            pass

    def build_tree(self):
        repos = self.fetch_catalog()
        if not repos:
            return

        self.root = TreeNode(self.registry_url, "registry", None, {"port": self.port})
        self.root.expanded = True

        dirs = {}
        for repo in repos:
            parts = repo.split('/')
            if len(parts) >= 2:
                dir_name = parts[0]
                img_name = '/'.join(parts[1:])
                if dir_name not in dirs:
                    dirs[dir_name] = TreeNode(dir_name + "/", "directory", self.root)
                img_data = {"repo": repo}
                img_node = TreeNode(img_name, "image", dirs[dir_name], img_data)
                dirs[dir_name].children.append(img_node)
            else:
                img_data = {"repo": repo}
                img_node = TreeNode(repo, "image", self.root, img_data)
                self.root.children.append(img_node)

        for dir_node in dirs.values():
            self.root.children.append(dir_node)

        self.root.children.sort(key=lambda x: x.name)

    def load_node_children(self, node):
        if node.loaded:
            return

        if node.node_type == "image":
            tags = self.fetch_tags(node.data["repo"])
            for tag in tags:
                tag_node = TreeNode(tag, "tag", node, {"repo": node.data["repo"], "tag": tag})
                node.children.append(tag_node)
        elif node.node_type == "tag":
            tag_name = node.data.get("tag", "")
            if tag_name.startswith("sha256-"):
                digest = tag_name
            else:
                digest = self.fetch_digest(node.data["repo"], tag_name)
            if digest:
                node.data["digest"] = digest
                manifest = self.fetch_manifest(node.data["repo"], digest)
                if manifest:
                    if manifest.get("schemaVersion") == 2:
                        media_type = manifest.get("mediaType", "")
                        if "manifest.list" in media_type or "image.index" in media_type:
                            for m in manifest.get("manifests", []):
                                platform = m.get("platform", {})
                                os = platform.get("os", "?")
                                arch = platform.get("architecture", "?")
                                variant = platform.get("variant", "")
                                if variant:
                                    platform_str = f"({os}/{arch}/{variant})"
                                else:
                                    platform_str = f"({os}/{arch})"
                                m_node = TreeNode(f"{m.get('digest', 'unknown')[:20]} {platform_str}", "manifest", node, m)
                                node.children.append(m_node)
                        elif "manifest.v2" in media_type or "image.manifest.v1" in media_type:
                            if "layers" in manifest:
                                for layer in manifest.get("layers", []):
                                    blob_node = TreeNode(layer.get("digest", "unknown")[:30], "blob", node, layer)
                                    node.children.append(blob_node)
                            if "config" in manifest:
                                config = manifest.get("config", {})
                                blob_node = TreeNode(config.get("digest", "unknown")[:30], "blob", node, {"digest": config.get("digest"), "size": config.get("size"), "mediaType": config.get("mediaType")})
                                node.children.append(blob_node)

        elif node.node_type == "manifest":
            manifest_digest = node.data.get("digest", "")
            if manifest_digest:
                repo = node.parent.data.get("repo") if node.parent and node.parent.data else None
                if repo:
                    manifest = self.fetch_manifest(repo, manifest_digest)
                    if manifest:
                        media_type = manifest.get("mediaType", "")
                        if "manifest.v2" in media_type or "image.manifest.v1" in media_type:
                            if "layers" in manifest:
                                for layer in manifest.get("layers", []):
                                    media_type = layer.get("mediaType", "")
                                    short_type = media_type.split('.')[-1] if media_type else "?"
                                    blob_node = TreeNode(f"{layer.get('digest', 'unknown')[:30]} ({short_type})", "blob", node, layer)
                                    node.children.append(blob_node)
                            if "config" in manifest:
                                config = manifest.get("config", {})
                                media_type = config.get("mediaType", "")
                                short_type = media_type.split('.')[-1] if media_type else "?"
                                blob_node = TreeNode(f"{config.get('digest', 'unknown')[:30]} ({short_type})", "blob", node, {"digest": config.get("digest"), "size": config.get("size"), "mediaType": config.get("mediaType")})
                                node.children.append(blob_node)

        node.loaded = True

    def get_visible_nodes(self):
        self.visible_nodes = []
        self._collect_visible(self.root, 0)
        return self.visible_nodes

    def _collect_visible(self, node, depth):
        if not node:
            return
        self.visible_nodes.append((node, depth))
        if node.expanded:
            self.load_node_children(node)
            for child in node.children:
                self._collect_visible(child, depth + 1)

    def run(self, stdscr):
        curses.curs_set(0)
        curses.start_color()
        curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLACK)
        curses.init_pair(2, curses.COLOR_GREEN, curses.COLOR_BLACK)
        curses.init_pair(3, curses.COLOR_RED, curses.COLOR_BLACK)
        curses.init_pair(4, curses.COLOR_YELLOW, curses.COLOR_BLACK)
        curses.init_pair(5, curses.COLOR_MAGENTA, curses.COLOR_BLACK)

        if not self.anonymous and (not self.username or not self.password):
            self.get_credentials(stdscr)

        if not self.authenticate():
            self.show_message(stdscr, "Authentication failed. Check credentials.", error=True)
            return

        stdscr.clear()
        self.show_loading(stdscr, "Loading repository catalog...")
        self.build_tree()
        if not self.root or not self.root.children:
            if self.anonymous:
                self.show_message(stdscr, "No repositories visible anonymously.", error=True)
            else:
                self.show_message(stdscr, "No repositories found.", error=True)
            return

        try:
            self.tree_view(stdscr)
        finally:
            self.close()

    def get_credentials(self, stdscr):
        stdscr.timeout(-1)
        stdscr.clear()
        h, w = stdscr.getmaxyx()
        y = h // 2 - 5

        stdscr.addstr(y, w // 2 - 15, "Quay Registry Client - Login", curses.A_BOLD)
        stdscr.addstr(y + 2, w // 2 - 10, "Username: ")
        stdscr.clrtoeol()
        curses.echo()
        username = stdscr.getstr(y + 2, w // 2 + 1, 30).decode('utf-8')
        stdscr.addstr(y + 4, w // 2 - 10, "Password: ")
        stdscr.clrtoeol()
        password = stdscr.getstr(y + 4, w // 2 + 1, 30, ord('*')).decode('utf-8')
        curses.noecho()

        self.username = username
        self.password = password
        stdscr.clear()

    def draw_tree(self, stdscr):
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        mode = " (anonymous)" if self.anonymous else ""
        title = f"Registry Browser - {self.registry_url}:{self.port}{mode}"
        stdscr.addstr(0, (w - len(title)) // 2, title, curses.A_BOLD | curses.color_pair(1))
        stdscr.addstr(1, 0, "=" * (w - 1))

        visible = self.get_visible_nodes()
        if not visible:
            stdscr.addstr(3, 2, "No items to display.", curses.color_pair(3))
        else:
            visible_rows = h - 4
            start_idx = max(0, self.selected_idx - visible_rows // 2)
            end_idx = min(len(visible), start_idx + visible_rows)

            for i in range(start_idx, end_idx):
                node, depth = visible[i]
                y = 2 + (i - start_idx)
                if y >= h - 2:
                    break

                prefix = "  " * depth
                icon = "[?]"
                if node.node_type == "directory":
                    icon = "[-]" if node.expanded else "[+]"
                elif node.node_type == "image":
                    icon = "[I]"
                    repo = node.data.get("repo", "")
                    tag_count = self._tag_counts.get(repo)
                    if tag_count is None:
                        # Queue the count; rendering never waits for the network.
                        self.request_tag_count(repo)
                    elif tag_count > 0:
                        base_name = node.data.get("display_name", "")
                        if not base_name:
                            base_name = node.name.split(" (")[0] if " (" in node.name else node.name
                            node.data["display_name"] = base_name
                        if f"({tag_count} tags)" not in node.name:
                            node.name = f"{base_name} ({tag_count} tags)"
                elif node.node_type == "tag":
                    icon = "[T]"
                elif node.node_type == "blob":
                    icon = "[B]"
                elif node.node_type == "manifest":
                    icon = "[M]"
                elif node.node_type == "registry":
                    icon = "[R]"
                    port = node.data.get("port", self.port)
                    node.name = f"{self.registry_url}:{port}"

                display = f"{prefix}{icon} {node.name}"
                is_match = i in self.search_matches
                if i == self.selected_idx:
                    stdscr.addstr(y, 2, display[:w-3], curses.A_REVERSE | curses.A_BOLD)
                elif is_match:
                    color = curses.color_pair(2)
                    stdscr.addstr(y, 2, display[:w-3], color | curses.A_BOLD)
                else:
                    color = curses.color_pair(1) if node.node_type == "directory" else \
                            curses.color_pair(2) if node.node_type == "image" else \
                            curses.color_pair(4) if node.node_type == "tag" else \
                            curses.color_pair(5) if node.node_type == "manifest" else \
                            curses.color_pair(3) if node.node_type == "blob" else \
                            curses.color_pair(3)
                    stdscr.addstr(y, 2, display[:w-3], color)

        match_info = f" [{self.current_match + 1}/{len(self.search_matches)}]" if self.search_matches else ""
        status = f"[/] Search | [n/N] Next/Prev | [Space] Expand | [Enter] Details | [q] Quit{match_info}"
        stdscr.addstr(h - 1, 0, status[:w - 1])
        return visible

    def show_loading(self, stdscr, message):
        """Show a one-line progress message while a blocking fetch runs."""
        h, w = stdscr.getmaxyx()
        try:
            stdscr.addstr(h - 2, 0, " " * (w - 1))
            stdscr.addstr(h - 2, 0, message[:w - 1], curses.color_pair(4))
            stdscr.refresh()
        except curses.error:
            pass

    def tree_view(self, stdscr):
        visible = []
        dirty = True
        while True:
            # Wake up regularly to collect tag counts fetched in the background.
            stdscr.timeout(200)
            if dirty:
                visible = self.draw_tree(stdscr)
                dirty = False

            key = stdscr.getch()
            if key == -1:
                if self._tag_count_updated.is_set():
                    self._tag_count_updated.clear()
                    dirty = True
                continue
            self._tag_count_updated.clear()
            dirty = True

            if key == ord('/'):
                term = self.get_search_input(stdscr)
                if term:
                    self.search_term = term
                    self._expand_only_matching_paths(term)
                    visible = self.get_visible_nodes()
                    self.search_matches = []
                    for i, (n, d) in enumerate(visible):
                        if self._node_matches_term(n, term):
                            self.search_matches.append(i)
                    self.current_match = 0
                    if self.search_matches:
                        self.selected_idx = self.search_matches[0]
                continue
            elif key == ord('n') and self.search_matches:
                if self.current_match < len(self.search_matches) - 1:
                    self.current_match += 1
                    self.selected_idx = self.search_matches[self.current_match]
                continue
            elif key == ord('N') and self.search_matches:
                if self.current_match > 0:
                    self.current_match -= 1
                    self.selected_idx = self.search_matches[self.current_match]
                continue

            if key == ord('q'):
                break
            elif key == curses.KEY_UP:
                self.selected_idx = max(0, self.selected_idx - 1)
            elif key == curses.KEY_DOWN:
                self.selected_idx = min(len(visible) - 1, self.selected_idx + 1)
            elif key == ord(' '):
                if 0 <= self.selected_idx < len(visible):
                    node, _ = visible[self.selected_idx]
                    old_expanded = node.expanded
                    if node.node_type == "directory":
                        node.expanded = not node.expanded
                    elif node.node_type in ("image", "tag", "manifest"):
                        node.expanded = not node.expanded
                        if node.expanded and not old_expanded:
                            # Lazy, one level at a time: expanding an image lists
                            # its tags, a tag lists its manifests, a manifest
                            # lists its blobs. The old eager walk loaded every
                            # tag + manifest + blob at once and froze the UI.
                            self.show_loading(stdscr, "Loading %s..." % node.name)
                            self.load_node_children(node)
                    if not old_expanded:
                        new_visible = self.get_visible_nodes()
                        for i, (n, d) in enumerate(new_visible):
                            if n == node:
                                self.selected_idx = i
                                break
            elif key == ord('\n') or key == curses.KEY_ENTER:
                if 0 <= self.selected_idx < len(visible):
                    node, _ = visible[self.selected_idx]
                    if node.node_type in ("image", "tag", "blob"):
                        self.show_node_details(stdscr, node)

    def show_node_details(self, stdscr, node):
        stdscr.timeout(-1)
        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()

            title = f"Details: {node.name}"
            stdscr.addstr(0, (w - len(title)) // 2, title, curses.A_BOLD | curses.color_pair(1))
            stdscr.addstr(1, 0, "=" * (w - 1))

            y = 3
            stdscr.addstr(y, 2, f"Type: {node.node_type}", curses.color_pair(2))

            if node.node_type == "image":
                stdscr.addstr(y + 1, 2, f"Repository: {node.data.get('repo', 'N/A')}", curses.color_pair(1))
                tags = self.fetch_tags(node.data.get("repo", ""))
                stdscr.addstr(y + 2, 2, f"Tags ({len(tags)}): {', '.join(tags[:10])}{'...' if len(tags) > 10 else ''}")
                stdscr.addstr(y + 3, 2, "Calculating size...")
                stdscr.refresh()
                size = self.calculate_image_size(node.data.get("repo", ""))
                stdscr.addstr(y + 3, 2, " " * 50)
                if size:
                    stdscr.addstr(y + 3, 2, f"Size: ~{self.format_size(size)}")
                else:
                    stdscr.addstr(y + 3, 2, "Size: unavailable")
            elif node.node_type == "tag":
                stdscr.addstr(y + 1, 2, f"Repository: {node.data.get('repo', 'N/A')}", curses.color_pair(1))
                stdscr.addstr(y + 2, 2, f"Tag: {node.data.get('tag', 'N/A')}", curses.color_pair(4))
                digest = node.data.get("digest", "Loading...")
                stdscr.addstr(y + 3, 2, f"Digest: {digest}", curses.color_pair(3))
            elif node.node_type == "blob":
                stdscr.addstr(y + 1, 2, f"Size: {node.data.get('size', 'N/A')}", curses.color_pair(1))
                stdscr.addstr(y + 2, 2, f"MediaType: {node.data.get('mediaType', 'N/A')}", curses.color_pair(4))

            stdscr.addstr(h - 1, 0, "Press [b] to go back or [q] to quit")

            key = stdscr.getch()
            if key == ord('b') or key == ord('q'):
                break

    def show_message(self, stdscr, message, error=False):
        stdscr.timeout(-1)
        stdscr.clear()
        h, w = stdscr.getmaxyx()
        y = h // 2
        color = curses.color_pair(3) if error else curses.color_pair(2)
        stdscr.addstr(y, (w - len(message)) // 2, message, color)
        stdscr.addstr(y + 2, (w - 20) // 2, "Press any key to exit...")
        stdscr.getch()


def main():
    parser = create_parser()

    if len(sys.argv) == 1:
        display_help()
        sys.exit(0)

    # parse_args (not parse_known_args): an unknown option or a bare word such
    # as "q=http" must be an error, not a silently ignored argument that turns
    # a search into "dump the whole catalog".
    args = parser.parse_args()

    if args.help:
        display_help()
        sys.exit(0)

    if args.generate_completion:
        generate_bash_completion()
        sys.exit(0)

    global debug
    debug = 1 if args.debug else None

    global PERSIST_CONNECTION
    if hasattr(args, 'persist_connection'):
        PERSIST_CONNECTION = bool(args.persist_connection)

    # fork: opt-in secret reveal (default OFF -> upstream LDAP login is masked)
    global SHOW_SECRETS
    if getattr(args, 'show_secrets', False):
        SHOW_SECRETS = True

    org = getattr(args, 'org', None)
    only_problems = getattr(args, 'only_problems', False)
    max_repos = getattr(args, 'max_repos', 0)
    cmd_early = args.command
    anonymous = getattr(args, 'anonymous', False)

    if anonymous and (args.username or args.password or args.token):
        printstderr("** --anonymous cannot be combined with -u/-p/-T")
        sys.exit(2)

    # fork: read-only hard lock (never mutate the registry)
    if READ_ONLY and cmd_early in DESTRUCTIVE_COMMANDS:
        printstderr("** READ-ONLY mode: '%s' is disabled in this fork." % cmd_early)
        printstderr("   Set READ_ONLY = False in the source if you really mean to mutate.")
        sys.exit(4)

    registry_url = args.registry_url
    Port = args.port
    username = args.username
    password = args.password
    token = args.token
    imageName = args.image_name
    tag = args.tag
    digest = args.digest
    apipath = args.apipath
    key = args.key
    value = args.value
    i_am_deleting_all_repo = args.i_am_deleting_all_repo

    if not args.command:
        display_help()
        sys.exit(0)           

    if registry_url:
        if "https://" in registry_url:
            registry_url = registry_url.replace("https://", "")
            Port=443
        # We capture the port from registry_url and cleanup registry_url to keep only the host
        pattern = r':(\d+)/$'
        match = re.search(pattern, registry_url)
        if match:
            Port = match.group(1)
            registry_url = registry_url.replace(match.group(0), "")
        pattern = r':(\d+)$'
        match = re.search(pattern, registry_url)
        if match:
            Port = match.group(1)
            registry_url = registry_url.replace(match.group(0), "")
    

    # Find the credentials in ~/.docker/config.json (or podman's auth.json).
    # FIX: was matching only "<host>:443" -> silently no creds -> 401 / empty.
    global RAW_BASIC, CREDS_FROM_STORE
    if registry_url is not None and username is None and password is None and token is None and not anonymous:
        # FIX: strip a trailing '/' so the key matches the stored bare hostname
        # (`podman search host/` works, the old "<host>/" lookup never did).
        clean_url = registry_url.strip().rstrip("/")
        cands = lookup_credentials(clean_url, Port)
        chosen = None
        for d, src in cands:
            ah = auth_header_for(d)
            if not ah:
                continue
            # probe EXACTLY like getToken() does (account+service), else we
            # reject valid credentials and fall back to an empty anonymous read
            ok = False
            if d.get("username") is not None:
                ok = v2_credential_accepted_account(registry_url, Port, ah,
                                                    d["username"])
            if not ok and d.get("raw"):
                ok = v2_credential_accepted(registry_url, Port, ah)
            if ok:
                chosen = (d, src)
                break
            if debug:
                printstderr("# candidate from %s not accepted by the account+service "
                            "probe (shape: %s)" % (src, d.get("shape", "?")))
        if chosen:
            d, src = chosen
            if d.get("raw"):
                RAW_BASIC = d["raw"]        # replayed VERBATIM, podman-identical
            username, password = d.get("username"), d.get("password")
            CREDS_FROM_STORE = True
            if debug:
                printstderr("# credential ACCEPTED from %s (shape: %s)"
                            % (src, d.get("shape", "login:password")))
        elif cands:
            # FIX: do NOT declare the credential dead. Two stores hold DIFFERENT
            # secrets for the same login here; podman's own search works, so the
            # probe (not the credential) may be the problem. Replay the first
            # candidate in podman's precedence order and let the real call speak.
            d, src = cands[0]
            if d.get("raw"):
                RAW_BASIC = d["raw"]
            username, password = d.get("username"), d.get("password")
            CREDS_FROM_STORE = True
            printstderr("** probe rejected %d candidate(s); replaying the first from %s"
                        " (podman precedence, values not shown)" % (len(cands), src))
            printstderr("   if the call below then 401s, re-authenticate with:"
                        "  podman login %s" % clean_url)
        elif debug:
            printstderr("# no credential found for %r; trying anonymous" % clean_url)

    if tag==None:
        tag="latest"

    cmd = args.command

    # fork: every /api/v1 command needs a real API credential (QRC_TOKEN or
    # -T token) -- the stored /v2 credential is refused by the Quay frontend.
    # Fail once, up front, instead of printing misleading empty results.
    if cmd in ("whoami", "list-org-repos", "org-robots", "repo-view",
               "mirror-get", "mirror-scan", "gc-audit", "quay-api-listuser",
               "list-organizations"):
        require_api_credential(token, username, password, registry_url, Port)

    if cmd == "get-server-certificate":
        if not all([registry_url,Port]):
            print(f"Error: missing parameters get-server-certificate(registry_url={registry_url},Port={Port})")
            sys.exit(2)
        getservercertificate(registry_url, Port)
    elif cmd == "quay-api-discovery":
        if not all([registry_url,Port,token]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters quay-api-discovery(registry_url={registry_url},Port={Port},token={token_val})")
            sys.exit(2)
        quayapidiscovery(registry_url,Port,token)
    elif cmd == "browse-api":
        if not all([registry_url,Port,token,apipath]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters browse-api(registry_url={registry_url},Port={Port},token={token_val},apipath={apipath})")
            sys.exit(2)
        browseapi(registry_url,Port,token,apipath)
    elif cmd == "quay-api-listuser":
        if not all([registry_url, Port]):
            print("Error: quay-api-listuser needs -r"); sys.exit(2)
        r = api_get(registry_url, Port, "/api/v1/superuser/users/",
                    username, password, token)
        if not describe_response(r, "/api/v1/superuser/users/"):
            if r.status_code == 403:
                printstderr("   -> superuser endpoint: a superuser credential and a "
                            "fresh login are required; -T remains the reliable path.")
            sys.exit(1)
        print_api_response(r)
    elif cmd == "list-organizations":
        if not all([registry_url, Port]):
            print("Error: list-organizations needs -r"); sys.exit(2)
        sys.exit(cmd_list_organizations(
            registry_url, Port, username, password, token,
            all_orgs=getattr(args, 'all_orgs', False),
            json_output=getattr(args, 'json', False),
        ))
    elif cmd == "quay-api-delete-user":
        if not all([registry_url,Port,token,username]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters quay-api-delete-user(registry_url={registry_url},Port={Port},token={token_val},username={username})")
            sys.exit(2)
        quayapi_delete_api_v1_superuser_users(registry_url,Port,token,username)
    elif cmd == "quay-api-create-user":
        if not all([registry_url,Port,token,username]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters quay-api-create-user(registry_url={registry_url},Port={Port},token={token_val},username={username})")
            sys.exit(2)
        quayapi_post_api_v1_superuser_users(registry_url,Port,token,username)
    elif cmd == "quay-api-change-userpassword":
