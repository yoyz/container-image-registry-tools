            ;;
        -T|--token|-u|--username|-p|--password|-P|--port|-D|--digest|-a|--apipath|-K|--key|-V|--value)
            COMPREPLY=()
            return 0
            ;;
        -d|-h)
            COMPREPLY=()
            return 0
            ;;
        *)
            local opts
