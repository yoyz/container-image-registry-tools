def cmd_org_exists(registry_url, Port, names):
    """
    fork: list the organizations WITHOUT any credential.
    Discovered by probe: on this Quay (ANONYMOUS_ACCESS=True) the public
    GET /api/v1/organization/<name> acts as an ORACLE:
        200 = org exists    404 = does not exist
    There is NO anonymous enumeration endpoint (no GET list-all-organizations
    exists in the swagger), so you probe a CANDIDATE list. Cheap, read-only,
    and enough to verify mirror_orgs / rom_quay_orgs / workflow divergence
    (synthese 8.10) against reality.
    The full authoritative list is GET /api/v1/superuser/users/ (needs a
    SUPERUSER token; orgs appear there because they are rows of "user" --
    synthese 5.3) -- reachable with: quay-api-listuser -T <supertoken>.
    """
    base = _base_url(registry_url, Port)
    print("### org oracle (anonymous GET /api/v1/organization/<name>)")
    print("  200 = EXISTS   404 = absent   401 = exists-but-private-something")
    yes, no, other = [], [], []
    for n in names:
        n = n.strip()
        if not n:
            continue
        r = requests.get(base + "/api/v1/organization/" + quote(n, safe=''),
                         timeout=20, allow_redirects=True)
        code = r.status_code
        if code == 200:
            try:
                nm = r.json().get("name")
            except ValueError:
                nm = n
            print("  EXISTS  %-20s (name=%r)" % (n, nm))
            yes.append(n)
        elif code == 404:
            print("  absent  %-20s" % n)
            no.append(n)
        else:
            print("  ????    %-20s HTTP %d" % (n, code))
            other.append(n)
    print("\n# existing: %s" % (", ".join(yes) or "-"))
    print("# absent  : %s" % (", ".join(no) or "-"))
    if other:
        print("# weird   : %s" % ", ".join(other))
    print("\n# To get the AUTHORITATIVE full list (incl. empty orgs and robots):")
    print("#   ./qrc.py quay-api-listuser -r %s -T <SUPERUSER token>" % registry_url)
    print("#   (orgs and robots are rows of \"user\", synthese 5.3; filter organization=true)")
    return yes, no


