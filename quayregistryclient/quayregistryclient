def lookup_credentials(registry_host, port="443"):
    """
    FIX (root cause of the 'silent empty / 401' behaviour):
    the original code looked the registry up ONLY as "<host>:<port>", but
    podman/docker store the key as the bare hostname (optionally with an
    https:// scheme). So the lookup silently returned {} and every call fell
    back to anonymous -> empty catalog / 401.
    Try, in order: bare host, host:port, both with scheme, and suffix match.
    NEVER prints or logs the secret. Returns a LIST of (dict, src) candidates.
    """
    found = []
    candidates = []
    for h in (registry_host,
              registry_host + ":" + str(port),
              registry_host.replace("https://", "").replace("http://", ""),
              "https://" + registry_host,
              "https://" + registry_host.replace("https://", "").replace("http://", "")):
        if h and h not in candidates:
            candidates.append(h)

    # FIX: podman does NOT read ~/.docker/config.json first -- it uses its own
    # store. The docker config can hold a DIFFERENT (older, or split-on-':')
    # entry, which is what made the tool 401 while `podman search` succeeded.
    # Order now mirrors podman's own precedence, and we collect EVERY match
    # rather than returning the first, so the caller can try them all.
    # podman's own precedence (verified on this host: the runtime dir store is
    # the one `podman login` writes; ~/.config/containers/auth.json does NOT
    # exist here and is only a documented fallback).
    for path in (os.environ.get("REGISTRY_AUTH_FILE", ""),
                 os.path.expandvars("$XDG_RUNTIME_DIR/containers/auth.json"),
                 "~/.config/containers/auth.json",
                 "~/.docker/config.json"):
        if not path:
            continue
        path = os.path.expanduser(path)
        if not os.path.exists(path):
            continue
        try:
            with open(path) as f:
                auths = json.load(f).get("auths", {})
        except Exception:
            continue
        # unambiguous label: a path is not a secret, and 'containers/auth.json'
        # used to hide WHICH file (XDG runtime vs ~/.config) was read.
        ap = os.path.abspath(os.path.expanduser(path))
        home = os.path.expanduser("~")
        if ap.startswith(home + "/"):
            src = "~/" + ap[len(home) + 1:]
        elif ap.startswith("/run/user/"):
            src = "$XDG_RUNTIME_DIR" + ap[len("/run/user"):]
        else:
            src = ap
        # exact matches first, but COLLECT all (podman may hold a different,
        # working entry than the docker config)
        seen = set()
        for c in candidates:
            if c in auths:
                d = _extract_pair(auths[c])
                if d and d.get("raw") not in seen:
                    seen.add(d.get("raw"))
                    found.append((d, src))
        # then: suffix match (handles a stored ":443" or scheme)
        for stored, val in auths.items():
            s = stored.replace("https://", "").replace("http://", "").rstrip("/")
            for c in candidates:
                cs = c.replace("https://", "").replace("http://", "").rstrip("/")
                if s == cs or s == cs + ":443":
                    d = _extract_pair(val)
                    if d and d.get("raw") not in seen:
                        seen.add(d.get("raw"))
                        found.append((d, src))
    return found


def _extract_raw_b64(reg_data):
    """
    fork FIX (this is the real reason the tool failed while `podman search`
    worked): a credential store entry may hold a value that is NOT a plain
    'login:password' pair (OAuth identity token, credential-helper placeholder,
    robot token...). Decoding it and splitting on ':' then INVENTS a login and a
    password, and the registry rightly answers 401 'Invalid username or
    password'. podman does not split: it replays the stored base64 verbatim as
    the Basic header. Do exactly the same -- byte-identical to podman.
    Returns the raw base64 string (never printed).
    """
    if not isinstance(reg_data, dict):
        return None
    raw = reg_data.get("auth")
    if not raw:
        return None
    try:
        base64.b64decode(raw, validate=True)
    except Exception:
        return None
    # only usable as Basic if it decodes to something containing a ':'
    try:
        dec = base64.b64decode(raw).decode("utf-8", "replace")
    except Exception:
        return None
    return raw if ":" in dec else None


def pair_shape(reg_data):
    """
    fork: report the SHAPE of the stored credential so the operator can tell a
    robot token from an LDAP login WITHOUT ever seeing either. Prints lengths
    and character classes only.
    """
    raw = reg_data.get("auth") if isinstance(reg_data, dict) else None
    if not raw:
        return "no 'auth' key (identitytoken only? -> /api/v1 needs -T token)"
    try:
        dec = base64.b64decode(raw).decode("utf-8", "replace")
    except Exception:
        return "undecodable 'auth'"
    if ":" not in dec:
        return "single token, no ':' (%d chars) -> NOT a login:password pair" % len(dec)
    u, p = dec.split(":", 1)
    def cls(s):
        if s.isdigit():
            return "all-digits"
        if re.fullmatch(r"[0-9a-f]{8,}", s):
            return "hex-like"
        if re.fullmatch(r"[A-Za-z0-9._-]{16,}", s):
            return "opaque-random"
        return "human-readable"
    return ("login=%d chars (%s), secret=%d chars (%s)"
            % (len(u), cls(u), len(p), cls(p)))


def _extract_pair(reg_data):
    """
    fork: return {'username','password','raw','shape'}. 'raw' is the stored
    base64 to be replayed VERBATIM (podman-identical) and is the preferred
    form; splitting is only a fallback for stores that keep explicit
    username/password keys.
    """
    if not isinstance(reg_data, dict):
        return None
    out = {}
    raw = _extract_raw_b64(reg_data)
    if raw:
        out["raw"] = raw
        out["shape"] = pair_shape(reg_data)
        try:
            dec = base64.b64decode(raw).decode("utf-8", "replace")
            if ":" in dec:
                u, p = dec.split(":", 1)
                out["username"], out["password"] = u, p
        except Exception:
            pass
        return out
    if "auth" in reg_data:
        # auth present but not a usable login:password -> keep raw anyway
        return {"raw": reg_data["auth"], "shape": pair_shape(reg_data)}
    if "username" in reg_data and "password" in reg_data:
        return {"username": reg_data["username"], "password": reg_data["password"],
                "shape": "explicit username/password keys"}
    return None


def cmd_search_v1(registry_url, Port, term, username=None, password=None,
                  token=None, pages_wanted=0, show_desc=False):
    """
    fork: the DEPRECATED registry V1 search API -- this is what
    `podman search <registry>/` actually calls, and on this Quay it is the
    ONLY working enumeration surface:
        /v2/_catalog  -> {"repositories":[]}   (superuser-only in practice)
        /v1/search    -> real results, but only WITH credentials (0 anonymous)
    Paginates via num_pages. Read-only.
    """
    base = _base_url(registry_url, Port)
    hdrs = {'Accept': 'application/json'}
    # basic_header() falls back to RAW_BASIC, so a verbatim blob with no usable
    # 'login:password' split still authenticates byte-identically to podman.
    if username is not None or RAW_BASIC:
        hdrs['Authorization'] = basic_header(username, password)
    elif token:
        hdrs['Authorization'] = "Bearer " + token

    # v1 is served over plain http on 80 in the spec, but Quay serves it on 443.
    r = requests.get(base + "/v1/search", headers=hdrs,
                     params={"q": term or "", "n": 100}, timeout=30)
    if r.status_code in (301, 302, 307, 308):
        loc = r.headers.get("Location", "")
        if loc:
            r = requests.get(loc, headers=hdrs, timeout=30)
    if not describe_response(r, "/v1/search?q=%r" % term):
        return None
    d = r.json()
    results = d.get("results") or d.get("result") or []
    npages = int(d.get("num_pages") or 1)
    print("### /v1/search  q=%r  page=%s/%s  this page=%d results"
          % (term or "*", d.get("page", 1), npages, len(results)))
    if results:
        print("    entry keys: %s" % sorted(results[0].keys()))
    for it in results:
        nm = it.get("name") or it.get("repo_name") or json.dumps(it)[:80]
        line = "  " + nm
        if show_desc:
            line += "   " + (it.get("description") or "")[:60]
        print(line)
    # paginate
    total = len(results)
    page = int(d.get("page") or 1)
    while page < npages and (pages_wanted == 0 or page < pages_wanted):
        page += 1
        rr = requests.get(base + "/v1/search", headers=hdrs,
                          params={"q": term or "", "page": page, "n": 100}, timeout=30)
        if rr.status_code != 200:
            printstderr("** page %d -> HTTP %d, stopping" % (page, rr.status_code))
            break
        dd = rr.json()
        rs = dd.get("results") or dd.get("result") or []
        for it in rs:
            print("  " + (it.get("name") or it.get("repo_name") or "?"))
        total += len(rs)
        if not rs:
            break
    print("# TOTAL collected: %d (%d pages)" % (total, page))
    return results


def v2_credential_accepted(registry_url, Port, auth_header, timeout=15):
    """
    fork: validate one candidate WITHOUT ever printing it.
    FIX: must mirror getToken() EXACTLY (account= AND service=). Probing with
    only service= yields a spurious 401, which made this gate reject perfectly
    good credentials -- a self-inflicted regression that turned a working
    list-catalog (962 repos) back into an anonymous empty answer.
    """
    try:
        r = requests.get(_base_url(registry_url, Port) + "/v2/auth",
                         headers={'Accept': 'application/json',
                                  'Authorization': auth_header},
                         params={"service": registry_url},
                         timeout=timeout, allow_redirects=False)
        return r.status_code == 200 and "token" in (r.text or "")
    except Exception:
        return False


def v2_credential_accepted_account(registry_url, Port, auth_header, account, timeout=15):
    """getToken()-identical probe: account=<login> + service=<host>."""
    try:
        r = requests.get(_base_url(registry_url, Port) + "/v2/auth",
                         headers={'Accept': 'application/json',
                                  'Authorization': auth_header},
                         params={"account": account, "service": registry_url},
                         timeout=timeout, allow_redirects=False)
        return r.status_code == 200 and "token" in (r.text or "")
    except Exception:
        return False


def auth_header_for(d):
    """Build the Authorization value for one stored candidate (never printed)."""
    if not isinstance(d, dict):
        return None
    if d.get("raw"):
        return "Basic " + d["raw"]          # replayed VERBATIM, podman-identical
    if d.get("username") is not None:
        return basic_header(d.get("username"), d.get("password"))
    return None


API_HEADERS = None    # fork: header set for /api/v1, ONLY from explicit user input

# ---------------------------------------------------------------------------
# fork: the THIRD auth mode, the one the redhat-cop / infra.quay_configuration
# collection actually uses, and the one this tool was missing.
# Read it in module_utils/api_module.py ::
#
#     def authenticate(self):
#         # Retrieve the CSRF cookie and token from /csrf_token (Quay 3.16+)
#         GET  /csrf_token                      -> {"csrf_token": ...} + cookie
#         POST /api/v1/signin  X-CSRF-Token: ...  {"username","password"}
#                                              -> Set-Cookie: session=...
#                                              -> X-Next-CSRF-Token: ...
#         self.session.headers.update({"X-CSRF-Token": token})
#
# i.e. the modules log in through the WEB UI endpoint and then carry a SESSION
# COOKIE. They NEVER send HTTP Basic to /api/v1 -- which is exactly why your
# Ansible job can read robots/mirrors while this tool, Basic-only, gets 401
# invalid_token.  /v2 (docker registry protocol) is the only place Basic works.
#
# NOTE ON 'READ-ONLY': POST /api/v1/signin mutates NO registry object. It opens
# a session. Like any authenticated call it may touch user.last_accessed and it
# does create an audit/login event server-side. It never creates, changes or
# deletes an org, repo, robot or mirror.
# ---------------------------------------------------------------------------
SESSION = None      # requests.Session holding the Quay session cookie
CSRF = None         # X-CSRF-Token value for the current session


def web_login(registry_url, Port, username, password, timeout=25):
    """
    Establish a /api/v1 session exactly like APIModule.authenticate().
    Returns True/False. NEVER prints, logs or returns any secret or cookie.
    Credentials come from the caller (api_headers_for): either the operator
    passed them explicitly (-u/-p or QRC_USERNAME/QRC_PASSWORD), or -- BY
    DEFAULT -- the login:pass read from the credential store is replayed to
    POST /api/v1/signin (set QRC_ALLOW_STORE_WEB_LOGIN=0 to forbid that).
    WARNING: a failed /signin bumps invalid_login_attempts on that account,
    which is often a shared service account that also carries every mirror
    (--src-creds) -- a typo can lock mirroring platform-wide.
    """
    global SESSION, CSRF
    if not username:
        return False
    base = _base_url(registry_url, Port)
    s = requests.Session()
    s.headers.update({'Accept': '*/*'})
    csrf = None
    # 1) CSRF from /csrf_token (Quay 3.16+), else window.__token from / (<=3.15)
    try:
        r = s.get(base + "/csrf_token", timeout=timeout)
        if r.status_code == 200:
            csrf = r.json().get("csrf_token")
    except Exception:
        csrf = None
    if not csrf:
        try:
            r = s.get(base + "/", timeout=timeout)
            m = re.search(r"window\.__token\s*=\s*'(.*?)';", r.text)
            csrf = m.group(1) if m else None
        except Exception:
            csrf = None
    if not csrf:
        if debug:
            printstderr("! web login: no CSRF token obtained from /csrf_token or /")
        return False
    # 2) the web sign-in
    try:
        r = s.post(base + "/api/v1/signin",
                   headers={'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-CSRF-Token': csrf},
                   data=json.dumps({"username": username, "password": password}),
                   timeout=timeout, allow_redirects=False)
    except Exception as e:
        if debug:
            printstderr("! web login: signin request failed (%s)" % type(e).__name__)
        return False
    if r.status_code != 200:
        # report status + Quay's own error text only -- no credential involved
        if debug:
            printstderr("! web login: POST /api/v1/signin -> HTTP %d %s"
                        % (r.status_code, (r.text or '')[:140].replace('\n', ' ')))
        return False
    h = {k.lower(): v for k, v in r.headers.items()}
    CSRF = h.get("x-next-csrf-token", csrf)
    SESSION = s
    if debug:
        printstderr("! web login: session established (cookie + CSRF held in memory only)")
    return True


class _NoAuthResult:
    """
    fork: placeholder returned by api_get() when no /api/v1 credential is
    available. Looks like a requests.Response just enough for the callers
    (status_code + describe_response) without ever hitting the network.
    """
    status_code = 0
    url = "(not sent: no /api/v1 credential)"
    text = ""
    headers = {}


def api_headers_for(token=None, username=None, password=None, registry=None, port=None):
    """
    fork: /api/v1 (mirror config, robots, repo view) does NOT accept Basic on
    this Quay -- it answers 401 'invalid_token' even though the same blob is
    accepted on /v2/auth.

    Three supported modes, in order:
      1. -T token / QRC_TOKEN                 -> 'Authorization: Bearer ...'
         (the OAuth app token of the per-org 'ansible' application, synthese
          4.5/9.1 -- this is what quay_api_token.py hands to the modules)
      2. QRC_COOKIE='session=...'             -> browser session replay
      3. WEB LOGIN (NEW, this is what the Ansible collection does):
         -u/-p or QRC_USERNAME/QRC_PASSWORD  -> GET /csrf_token
                                             -> POST /api/v1/signin
                                             -> session cookie + X-CSRF-Token
         See module_utils/api_module.py::APIModule.authenticate(). The modules
         NEVER send HTTP Basic to /api/v1; they sign in to the web UI and carry
         a session. That is the whole difference with this tool, which was
         Basic-only.

    SECURITY: never derives or replays the /v2 stored blob as an API
    credential. Web login only happens with credentials the operator passes
    explicitly for it.
    """
    global API_HEADERS, RAW_BASIC
    if API_HEADERS is not None and not token and not os.environ.get("QRC_TOKEN") \
       and not os.environ.get("QRC_COOKIE") and not username:
        return API_HEADERS
    tok = token or os.environ.get("QRC_TOKEN")
    if tok:
        h = {'Accept': 'application/json', 'Authorization': "Bearer " + tok}
        API_HEADERS = h
        return h
    ck = os.environ.get("QRC_COOKIE")
    if ck:
        h = {'Accept': 'application/json', 'Cookie': ck}
        API_HEADERS = h
        return h
    # mode 3: web sign-in, exactly like the Ansible collection
    u = username or os.environ.get("QRC_USERNAME")
    p = password or os.environ.get("QRC_PASSWORD", "")
    if u and registry:
        # Credentials the operator passes explicitly override any stored blob,
        # otherwise basic_header()/web_login() would silently use the WRONG pair.
        if not CREDS_FROM_STORE and RAW_BASIC:
            # operator gave -u/-p explicitly on the command line: never let a
            # previously loaded store blob override it in basic_header().
            RAW_BASIC = None
            if debug:
                printstderr("- explicit -u/-p given; ignoring any stored blob")
        # Credentials auto-loaded from a credential file are replayed to the
        # WEB sign-in BY DEFAULT (ALLOW_STORE_WEB_LOGIN defaults to "1") --
        # this is the operator's own login:pass. Set QRC_ALLOW_STORE_WEB_LOGIN=0
        # to require explicit -u/-p or QRC_TOKEN instead. WARNING: a failed
        # /signin bumps invalid_login_attempts on that account, which is often
        # a shared service account that also carries every mirror
        # (--src-creds) -- a typo can lock mirroring platform-wide.
        # Credentials the operator passes explicitly for THIS run (-u/-p,
        # QRC_USERNAME) are used directly, exactly like the Ansible modules do.
        if CREDS_FROM_STORE and not ALLOW_STORE_WEB_LOGIN:
            if debug:
                printstderr("- web login skipped: credentials came from a credential "
                            "file and QRC_ALLOW_STORE_WEB_LOGIN=0 forbids replaying "
                            "them to POST /api/v1/signin; pass -u/-p explicitly or "
                            "unset QRC_ALLOW_STORE_WEB_LOGIN to allow it")
            return None
        if SESSION is not None or web_login(registry, port or 443, u, p):
            return {'Accept': 'application/json'}   # SESSION carries the cookie
        return None
    return None


def explain_api_auth_needed(registry_url):
    printstderr("** /api/v1 needs an OAuth/app token or a session cookie -- the stored")
