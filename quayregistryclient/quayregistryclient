            print(f"Error: missing parameters image-digest(registry_url={registry_url},username={username},password={password_val},Port={Port},imageName={imageName},digest={digest})")
            sys.exit(2)
        getimagemanifest(registry_url, username, password,Port,imageName,digest)
    elif cmd == "get-blob":
        if not all([registry_url, username, password,Port,imageName,digest]):
            password_val="##maskingPassword##" if password is not None else password
            print(f"Error: missing parameters get-blob(registry_url={registry_url},username={username},password={password_val},Port={Port},imageName={imageName},digest={digest})")
            sys.exit(2)
        getblob(registry_url, username, password,Port,imageName,digest)
    elif cmd == "delete-repo":
        if not all([registry_url, Port, imageName, token]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters delete-repo(registry_url={registry_url},Port={Port},imageName={imageName},token={token_val})")
            sys.exit(2)
        deleterepo(registry_url, Port,imageName,token)
    elif cmd == "delete-tag":
        if not all([registry_url, Port,imageName,token,tag]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters delete-tag(registry_url={registry_url},Port={Port},imageName={imageName},token={token_val},tag={tag})")
            sys.exit(2)
        deletetag(registry_url, Port,imageName,token,tag)
    elif cmd == "set-api-key-value":
        if not all([registry_url, Port,token,apipath,key,value]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters set-api-key-value(registry_url={registry_url},Port={Port},token={token_val},apipath={apipath},key={key},value={value})")
            sys.exit(2)
        setapikeyvalue(registry_url, Port,token,apipath,key,value)
    elif cmd == "delete-all-repo":
        if not i_am_deleting_all_repo:
            print("ERROR: SAFETY CHECK FAILED.")
            print("This is a destructive operation that will wipe the entire registry.")
            print("To proceed, you must strictly add the flag: --i-am-deleting-all-repo")
            sys.exit(1)
        if not all([registry_url, username, password,Port,token]):
            token_val="##maskingToken##" if token is not None else token
            print(f"Error: missing parameters delete-all-repo(registry_url={registry_url},Port={Port},token={token_val})")
            sys.exit(2)
        delete_all_countdown(registry_url, Port)
        deleteallrepo(registry_url, username, password,Port,token)
    # ================= fork: read-only Quay mirroring API commands =================
    elif cmd == "quay-config":
        get_config(registry_url, Port)
    elif cmd == "whoami":
        if whoami(registry_url, Port, username, password, token) is None:
            sys.exit(1)
    elif cmd == "list-org-repos":
        if not all([registry_url, Port, org]):
            print("Error: list-org-repos needs -r and -o <org>"); sys.exit(2)
        repos, pages, trunc = quay_list_org_repos(registry_url, Port, org,
                                                  username, password, token)
        for x in sorted(repos):
            print(x)
        printstderr("# %d repositories in %d pages%s"
                    % (len(repos), pages, " (TRUNCATED)" if trunc else ""))
        if not repos and not (username or token):
            printstderr("** EMPTY, but you are ANONYMOUS. On this Quay all repos are private,")
            printstderr("   so 'anonymous + empty' looks exactly like 'org is empty'.")
            printstderr("   Authenticate (credentials in ~/.docker/config.json, or -u/-p/-T) before concluding.")
    elif cmd == "org-robots":
        if not all([registry_url, Port, org]):
            print("Error: org-robots needs -r and -o <org>"); sys.exit(2)
        if cmd_org_robots(registry_url, Port, org, username, password, token) is None:
            sys.exit(1)
    elif cmd == "repo-view":
        if not all([registry_url, Port, imageName]):
            print("Error: repo-view needs -r and -i <org/repo>"); sys.exit(2)
        if cmd_repo_view(registry_url, Port, imageName, username, password, token) is None:
            sys.exit(1)
    elif cmd == "mirror-get":
        if not all([registry_url, Port, imageName]):
            print("Error: mirror-get needs -r and -i <org/repo>"); sys.exit(2)
        if cmd_mirror_get(registry_url, Port, imageName, username, password, token) is None:
            sys.exit(1)
    elif cmd == "mirror-scan":
        if not all([registry_url, Port, org]):
            print("Error: mirror-scan needs -r and -o <org>"); sys.exit(2)
        cmd_mirror_scan(registry_url, Port, org, username, password, token,
                        only_problems=only_problems, max_repos=max_repos,
                        offset=getattr(args, 'offset', 0))
    elif cmd == "gc-audit":
        if not all([registry_url, Port]):
            print("Error: gc-audit needs -r"); sys.exit(2)
        all_repos = getattr(args, 'all_repos', False)
        org = getattr(args, 'org', None)
        if all_repos:
            if not org:
                print("Error: gc-audit --all-repos needs -o <organization>"); sys.exit(2)
            if imageName:
                print("Error: gc-audit accepts either -i <org/repo> or "
                      "-o <org> --all-repos, not both"); sys.exit(2)
            sys.exit(cmd_gc_audit_all(
                registry_url, Port, org, username, password, token,
                json_output=getattr(args, 'json', False),
                only_problems=getattr(args, 'only_problems', False),
                blob_check=not getattr(args, 'no_blob_check', False),
                max_tags=getattr(args, 'max_tags', 200),
                logs_days=getattr(args, 'logs_days', 0),
                jobs=getattr(args, 'jobs', 8),
                repo_jobs=getattr(args, 'repo_jobs', 4),
                fail_on_problem=getattr(args, 'fail_on_problem', False),
                show_tags=getattr(args, 'show_tags', False),
            ))
        if not imageName:
            print("Error: gc-audit needs -i <org/repo>, or -o <org> --all-repos")
            sys.exit(2)
        sys.exit(cmd_gc_audit(
            registry_url, Port, imageName, username, password, token,
            json_output=getattr(args, 'json', False),
            only_problems=getattr(args, 'only_problems', False),
            blob_check=not getattr(args, 'no_blob_check', False),
            max_tags=getattr(args, 'max_tags', 200),
            logs_days=getattr(args, 'logs_days', 0),
            jobs=getattr(args, 'jobs', 8),
            fail_on_problem=getattr(args, 'fail_on_problem', False),
            show_tags=getattr(args, 'show_tags', False),
        ))
    elif cmd == "org-exists":
        if not all([registry_url, Port]):
            print("Error: org-exists needs -r"); sys.exit(2)
        raw = getattr(args, 'orgs', '') or ""
        if not raw:
            printstderr("** --orgs is REQUIRED. No org list is hardcoded here: a generic")
            printstderr("   registry client must not embed one customer's inventory.")
            printstderr("   e.g.  --orgs orgA,orgB,orgC   (probed one by one: 200=exists/404=absent)")
            sys.exit(2)
        cmd_org_exists(registry_url, Port, [x for x in raw.split(",") if x.strip()])
    elif cmd == "search-v1":
        if not all([registry_url, Port]):
            print("Error: search-v1 needs -r"); sys.exit(2)
        if cmd_search_v1(registry_url, Port, getattr(args, 'query', '') or imageName,
                         username, password, token,
                         pages_wanted=getattr(args, 'pages', 0),
                         show_desc=getattr(args, 'desc', False)) is None:
            sys.exit(1)
    elif cmd == "search-v2":
        if not all([registry_url, Port]):
            print("Error: search-v2 needs -r"); sys.exit(2)
        if cmd_search_v2(registry_url, Port, getattr(args, 'query', '') or imageName,
                         username, password, token,
                         anonymous=anonymous,
                         max_pages=getattr(args, 'pages', 0)) is None:
            sys.exit(1)
    elif cmd == "interactive":
        from curses import wrapper
        loop = QueryLoop(registry_url, Port, username, password, debug,
                         anonymous=anonymous)
        wrapper(loop.run)
    else:
        print("A command is needed.")
        print("")
        display_help()
        sys.exit(0)

    sys.exit(0)


