_get_arg_value() {
    local short="$1"
    local long="$2"
    local i
    for ((i=1; i<${#COMP_WORDS[@]}; i++)); do
        if [[ "${COMP_WORDS[i]}" == "${short}" || "${COMP_WORDS[i]}" == "${long}" ]]; then
            echo "${COMP_WORDS[i+1]}"
            return
        fi
    done
}

