        print("  %-58s created=%-26s has_token=%s  description=%s"
              % (rb.get("name"),
                 rb.get("created") or rb.get("date_created") or "?",
                 bool(rb.get("token")),
                 (rb.get("description") or "")[:38]))
    return True


def cmd_repo_view(registry_url, Port, imageName, username=None, password=None, token=None):
    """Repository view: gives `state` (NORMAL vs MIRROR -- synthese 2.2/8.14)."""
    apipath = "/api/v1/repository/" + quote(imageName.strip("/"), safe='/')
    r = api_get(registry_url, Port, apipath, username, password, token)
    if not describe_response(r, "repo view " + imageName):
        return None
    d = r.json()
    print("### repository: %s" % imageName)
    for k in ("name", "namespace", "state", "is_public", "is_mirror", "permission",
              "star_count", "repo_type", "size", "last_modified"):
        if k in d:
            v = d[k]
            if k == "permission":
                v = json.dumps(v)[:200]
            print("  %-14s = %s" % (k, v))
    if str(d.get("state")) == "MIRROR":
        print("  -> state=MIRROR : pushes are REFUSED (oc-mirror must flip to NORMAL first, synthese 8.14)")
    return d


def _gc_fmt_bytes(n):
    if n is None:
        return "?"
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "?"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024:
            if unit == "B":
                return "%d B" % n
            return "%.1f %s" % (n, unit)
        n /= 1024
    return "%.1f PiB" % n


def _gc_fmt_seconds(seconds):
    if seconds is None:
        return "?"
    seconds = int(seconds)
    if seconds % 86400 == 0:
        return "%dd" % (seconds // 86400)
    if seconds % 3600 == 0:
        return "%dh" % (seconds // 3600)
    return "%ds" % seconds


def _gc_iso_ts(ts):
    if ts is None:
        return None
    try:
        return datetime.fromtimestamp(float(ts), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OSError):
        return None


def _gc_v2_token_for_repo(registry_url, Port, imageName, username=None,
                          password=None, token=None):
    """Fetch a /v2 pull token without ever aborting the audit on failure."""
    auth_url = _base_url(registry_url, Port) + "/v2/auth"
    scope = "repository:%s:pull" % imageName.strip("/")
    attempts = []
    if username is not None or RAW_BASIC:
        attempts.append(({"Authorization": basic_header(username, password)}, "basic"))
    if token:
        attempts.append(({"Authorization": "Bearer " + token}, "bearer"))
    attempts.append(({}, "anonymous"))

    last_error = "no registry credential"
    for auth, mode in attempts:
        headers = {"Accept": "application/json"}
        headers.update(auth)
        params = {"service": registry_url, "scope": scope}
        if username:
            params["account"] = username
        try:
            r = _http_session().get(auth_url, headers=headers, params=params,
                                    timeout=20)
        except requests.exceptions.RequestException as exc:
            last_error = "%s: %s" % (mode, exc)
            continue
        if r.status_code != 200:
            last_error = "%s: HTTP %d" % (mode, r.status_code)
            continue
        try:
            data = r.json()
        except ValueError:
            last_error = "%s: invalid JSON" % mode
            continue
        tok = data.get("token") or data.get("access_token")
        if tok:
            return tok, mode
        last_error = "%s: no token in response" % mode
    return None, last_error


def _gc_v2_get_manifest(registry_url, Port, imageName, digest, v2token):
    if not v2token:
        return None, "no /v2 pull token"
    url = (_base_url(registry_url, Port) + "/v2/" + imageName.strip("/")
           + "/manifests/" + quote(digest, safe=':'))
    headers = {"Accept": GC_AUDIT_MANIFEST_ACCEPT,
               "Authorization": "Bearer " + v2token}
    try:
        r = _http_session().get(url, headers=headers, timeout=40,
                                allow_redirects=True)
    except requests.exceptions.RequestException as exc:
        return None, "request failed: %s" % exc
    if r.status_code == 200:
        return r.content, None
    return None, "HTTP %d" % r.status_code


def _gc_head_blob(registry_url, Port, imageName, digest, v2token):
    """Return {'status': present|missing|unchecked, 'size': int|None, 'detail': str}."""
    if not v2token:
        return {"status": "unchecked", "size": None,
                "detail": "no /v2 pull token"}
    url = (_base_url(registry_url, Port) + "/v2/" + imageName.strip("/")
           + "/blobs/" + quote(digest, safe=':'))
    headers = {"Authorization": "Bearer " + v2token}
    try:
        r = _http_session().head(url, headers=headers, timeout=40,
                                 allow_redirects=True)
    except requests.exceptions.RequestException as exc:
        return {"status": "unchecked", "size": None, "detail": "request failed: %s" % exc}

    if r.status_code == 200:
        size = r.headers.get("Content-Length")
        try:
            size = int(size) if size is not None else None
        except ValueError:
            size = None
        return {"status": "present", "size": size, "detail": "HEAD 200"}
    if r.status_code == 404:
        return {"status": "missing", "size": None, "detail": "HEAD 404"}

    # Some proxies dislike HEAD: fall back to a one-byte ranged GET.
    if r.status_code in (405, 501):
        try:
            g = _http_session().get(url, headers=dict(headers, Range="bytes=0-0"),
                                    timeout=40, allow_redirects=True, stream=True)
        except requests.exceptions.RequestException as exc:
            return {"status": "unchecked", "size": None,
                    "detail": "HEAD %d; GET failed: %s" % (r.status_code, exc)}
        try:
            if g.status_code in (200, 206):
                size = None
                content_range = g.headers.get("Content-Range", "")
                if "/" in content_range:
                    try:
                        size = int(content_range.rsplit("/", 1)[1])
                    except ValueError:
                        size = None
                elif g.headers.get("Content-Length"):
                    try:
                        size = int(g.headers["Content-Length"])
                    except ValueError:
                        size = None
                return {"status": "present", "size": size,
                        "detail": "ranged GET %d" % g.status_code}
            return {"status": "unchecked", "size": None,
                    "detail": "HEAD %d; GET %d" % (r.status_code, g.status_code)}
        finally:
            g.close()

    if r.status_code in (401, 403):
        return {"status": "unchecked", "size": None,
                "detail": "HTTP %d: token lacks pull scope or was rejected" % r.status_code}
    return {"status": "unchecked", "size": None, "detail": "HTTP %d" % r.status_code}


def _gc_parse_manifest_document(parsed, digest=None, media_type=None,
                                layers_override=None):
    info = {
        "digest": digest or (parsed.get("digest") if isinstance(parsed, dict) else None),
        "media_type": media_type,
        "is_index": False,
        "children": [],
        "layers": [],
        "config": None,
        "artifacts": [],
        "schema1": False,
        "source": None,
        "metadata_broken": False,
        "error": None,
    }
    if not isinstance(parsed, dict):
        return info
    if not info["media_type"]:
        info["media_type"] = parsed.get("mediaType")

    children = parsed.get("manifests")
    if isinstance(children, list):
        info["is_index"] = True
        for entry in children:
            if isinstance(entry, dict) and entry.get("digest"):
                info["children"].append(entry["digest"])

    # Prefer the manifest bytes (source of truth).  The API's `layers` list is
    # built from DB rows and would be shorter if a ManifestBlob row is missing:
    # exactly the situation gc-audit is trying to detect.
    raw_layers = parsed.get("layers") if parsed.get("layers") else layers_override
    if isinstance(raw_layers, list):
        for layer in raw_layers:
            if not isinstance(layer, dict):
                continue
            layer_digest = layer.get("blob_digest") or layer.get("digest")
            if not layer_digest:
                continue
            size = layer.get("compressed_size", layer.get("size"))
            try:
                size = int(size) if size is not None else None
            except (TypeError, ValueError):
                size = None
            info["layers"].append({
                "digest": layer_digest,
                "size": size,
                "remote": bool(layer.get("urls") or layer.get("is_remote")),
            })

    config = parsed.get("config")
    if isinstance(config, dict) and config.get("digest"):
        size = config.get("size")
        try:
            size = int(size) if size is not None else None
        except (TypeError, ValueError):
            size = None
        info["config"] = {"digest": config["digest"], "size": size}

    blobs = parsed.get("blobs")
    if isinstance(blobs, list):
        for blob in blobs:
            if not isinstance(blob, dict) or not blob.get("digest"):
                continue
            size = blob.get("size")
            try:
                size = int(size) if size is not None else None
            except (TypeError, ValueError):
                size = None
            info["artifacts"].append({"digest": blob["digest"], "size": size})

    # Docker schema 1 manifests use fsLayers and have no config descriptor.
    fs_layers = parsed.get("fsLayers")
    if not info["layers"] and isinstance(fs_layers, list):
        info["schema1"] = True
        for layer in fs_layers:
            if isinstance(layer, dict) and layer.get("blobSum"):
                info["layers"].append({
                    "digest": layer["blobSum"], "size": None, "remote": False,
                })

    return info


def _gc_audit_manifest(registry_url, Port, imageName, digest, username, password,
                       token, v2token, cache):
    if digest in cache:
        return cache[digest]

    info = {
        "digest": digest, "media_type": None, "is_index": False, "children": [],
        "layers": [], "config": None, "artifacts": [], "schema1": False,
        "source": None, "metadata_broken": False, "error": None,
    }
    apipath = ("/api/v1/repository/" + quote(imageName.strip("/"), safe='/')
               + "/manifest/" + quote(digest, safe=':'))
    r = api_get(registry_url, Port, apipath, username, password, token)
    if r.status_code == 200:
        try:
            data = r.json()
        except ValueError:
            data = {}
        parsed = {}
        parse_failed = False
        raw = data.get("manifest_data")
        if isinstance(raw, str) and raw.strip():
            try:
                parsed = json.loads(raw)
            except ValueError:
                parsed = {}
                parse_failed = True
        info = _gc_parse_manifest_document(
            parsed,
            digest=data.get("digest") or digest,
            media_type=parsed.get("mediaType") or data.get("config_media_type"),
            layers_override=data.get("layers"),
        )
        info["source"] = "api"
        info["metadata_broken"] = parse_failed
        if data.get("is_manifest_list"):
            info["is_index"] = True
        if info["is_index"] and not info["children"]:
            info["metadata_broken"] = True
    else:
        raw, v2_error = _gc_v2_get_manifest(registry_url, Port, imageName,
                                            digest, v2token)
        if raw is not None:
            try:
                parsed = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                parsed = {}
            info = _gc_parse_manifest_document(parsed, digest=digest)
            info["source"] = "v2"
            info["metadata_broken"] = True
            if not parsed:
                info["error"] = "unparseable /v2 manifest"
        else:
            info["error"] = "API HTTP %s; /v2 %s" % (r.status_code, v2_error)

    cache[digest] = info
    return info


def _gc_add_blob_ref(blob_refs, digest, size, remote, tag, tag_active,
                     manifest_digest, kind):
    if not digest:
        return
    if tag is None:
        tag = "?"
    ref = blob_refs.setdefault(digest, {
        "digest": digest,
        "size": None,
        "remote": remote,
        "tag_refs": set(),
        "manifests": set(),
        "kinds": set(),
    })
    if ref["size"] is None and size is not None:
        ref["size"] = size
    # A digest referenced by both a foreign layer and a local layer must be checked.
    ref["remote"] = ref["remote"] and remote
    ref["tag_refs"].add((tag, bool(tag_active)))
    ref["manifests"].add(manifest_digest)
    ref["kinds"].add(kind)


def _gc_note_missing_child(ctx, parent, child, tag, error=None):
    key = (parent, child)
    entry = ctx["missing_children"].setdefault(key, {
        "parent": parent, "digest": child, "tags": set(), "error": error,
    })
    entry["tags"].add(tag)
    if error and not entry.get("error"):
        entry["error"] = error


def _gc_walk_manifest(ctx, digest, tag, depth=0, path=None, tag_active=True):
    if depth > 8:
        ctx["manifest_errors"].append({
            "digest": digest, "tag": tag, "active": tag_active,
            "error": "manifest tree deeper than 8 levels",
        })
        return False
    if path is None:
        path = set()
    if digest in path:
        return True

    info = _gc_audit_manifest(
        ctx["registry_url"], ctx["port"], ctx["image_name"], digest,
        ctx["username"], ctx["password"], ctx["token"], ctx["v2token"],
        ctx["cache"],
    )
    if info["error"]:
        # A missing child of a manifest list is normal for sparse mirror
        # manifests; only a root tag manifest is an actual audit failure.
        if depth == 0:
            ctx["manifest_errors"].append({
                "digest": digest, "tag": tag, "active": tag_active,
                "error": info["error"],
            })
        else:
            ctx["manifest_child_errors"] = ctx.get("manifest_child_errors", {})
            ctx["manifest_child_errors"][digest] = info["error"]
        return False

    if info["is_index"]:
        if not info["children"]:
            ctx["manifest_errors"].append({
                "digest": digest, "tag": tag, "active": tag_active,
                "error": "manifest list/index has no child digest",
            })
            return True
        for child in info["children"]:
            if not _gc_walk_manifest(ctx, child, tag, depth + 1,
                                     path | {digest}, tag_active):
                _gc_note_missing_child(
                    ctx, digest, child, tag,
                    (ctx.get("manifest_child_errors") or {}).get(child),
                )
        return True

    for layer in info["layers"]:
        _gc_add_blob_ref(ctx["blob_refs"], layer["digest"], layer["size"],
                         layer["remote"], tag, tag_active, digest, "layer")
    if info["config"]:
        _gc_add_blob_ref(ctx["blob_refs"], info["config"]["digest"],
                         info["config"]["size"], False, tag, tag_active,
                         digest, "config")
    for artifact in info["artifacts"]:
        _gc_add_blob_ref(ctx["blob_refs"], artifact["digest"],
                         artifact["size"], False, tag, tag_active,
                         digest, "artifact")
    return True


def _gc_fetch_logs(registry_url, Port, imageName, username, password, token, days):
    end = datetime.now(timezone.utc)
    start = end - timedelta(days=days)
    apipath = ("/api/v1/repository/" + quote(imageName.strip("/"), safe='/')
               + "/logs")
    params = {
        "starttime": start.strftime("%m/%d/%Y"),
        "endtime": end.strftime("%m/%d/%Y"),
    }
    result = {
        "window_days": days,
        "start": start.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "end": end.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "counts": {},
        "events": [],
        "pages": 0,
        "unavailable": None,
    }
    for _ in range(50):
        r = api_get(registry_url, Port, apipath, username, password, token,
                    params=params)
        if r.status_code != 200:
            result["unavailable"] = "HTTP %d" % r.status_code
            break
        try:
            data = r.json()
        except ValueError:
            result["unavailable"] = "invalid JSON"
            break
        if data.get("search_unavailable"):
            result["unavailable"] = data.get("message") or "search unavailable"
            break
        result["pages"] += 1
        for log in data.get("logs") or []:
            kind = log.get("kind")
            if kind not in GC_AUDIT_LOG_KINDS and "autoprune" not in (kind or ""):
                continue
            result["counts"][kind] = result["counts"].get(kind, 0) + 1
            metadata = log.get("metadata") or {}
            performer = (log.get("performer") or {}).get("name")
            result["events"].append({
                "datetime": log.get("datetime"),
                "kind": kind,
                "tag": metadata.get("tag"),
                "performer": performer,
            })
        next_page = data.get("next_page")
        if not next_page:
            break
        params["next_page"] = next_page
    return result


def _gc_print_text(result, only_problems=False, show_tags=False):
    print("### GC audit: %s" % result["repository"])
    print("  %-24s = %s" % ("state", result["state"]))
    window = result["tag_expiration_s"]
    print("  %-24s = %s%s" % (
        "tag_expiration_s",
        window if window is not None else "?",
        " (%s)" % _gc_fmt_seconds(window) if window is not None else "",
    ))
    if window is None:
        print("  ** tag_expiration_s unknown: GC-eligibility dates cannot be computed")
    print("  %-24s = %s" % ("is_public", result["is_public"]))
    print("  %-24s = %s" % ("generated_at", result["generated_at"]))
    if result["state"] == "MARKED_FOR_DELETION":
        print("  -> repository queued for deletion; the GC worker will purge it asynchronously")
    if result["tags"]["truncated"]:
        print("  ** tag list truncated at --max-tags %d" % result["tags"]["max_tags"])

    print("")
    print("### retention / auto-prune")
    for label in ("repository", "organization"):
        block = result["retention"][label]
        if block.get("error"):
            print("  %s policies: unavailable (%s)" % (label, block["error"]))
        elif not block.get("policies"):
            print("  %s policies: none" % label)
        else:
            print("  %s policies:" % label)
            for policy in block["policies"]:
                print("    - method=%s value=%s tagPattern=%r tagPatternMatches=%s"
                      % (policy.get("method"), policy.get("value"),
                         policy.get("tagPattern"), policy.get("tagPatternMatches")))

    tags = result["tags"]
    print("")
    print("### tags")
    print("  rows=%d unique_names=%d active_names=%d expired_rows=%d "
          "(pending=%d gc_eligible=%d)"
          % (tags["total"], tags["unique_names"], tags["active_names"],
             tags["expired_rows"], tags.get("pending_rows",
                                            tags["expired_pending_gc"]),
             tags.get("gc_eligible_rows", tags["gc_eligible"])))
    print("  one line per tag name; historical versions are summarized as history=N")

    # Quay's tag API returns the full tag history: the same name can have one
    # alive row plus several expired rows (one per re-target/reversion).  Keep
    # one display line per name, and put the details in `history=N`.
    groups = {}
    for tag_item in tags["items"]:
        groups.setdefault(tag_item["name"] or "?", []).append(tag_item)

    # First pass: decide which tag names are displayed, so the name column can
    # be padded to the longest *displayed* tag instead of a fixed width.
    displayed = []
    for name, rows in groups.items():
        active_rows = [item for item in rows if item["active"]]
        eligible_rows = [item for item in rows if item["gc_eligible"]]
        pending_rows = [
            item for item in rows
            if (not item["active"]) and (not item["gc_eligible"])]
        if only_problems and active_rows and not (eligible_rows or pending_rows):
            if not show_tags:
                continue
        displayed.append((name, rows, active_rows, eligible_rows, pending_rows))

    name_width = max([len(name) for name, _rows, _a, _e, _p in displayed] or [1])
    for name, rows, active_rows, eligible_rows, pending_rows in displayed:
        eligible_count = len(eligible_rows)
        pending_count = len(pending_rows)

        if active_rows:
            state = "active"
            current = active_rows[0]
        elif eligible_rows:
            state = "gc-eligible"
            current = eligible_rows[0]
        elif pending_rows:
            state = "pending"
            current = pending_rows[0]
        else:
            state = "expired"
            current = rows[0]

        suffix = ""
        if current["end_ts"] is not None:
            if current["active"]:
                suffix += " expires_at=%s" % _gc_iso_ts(current["end_ts"])
            else:
                suffix += " end_ts=%s gc_after=%s" % (
                    _gc_iso_ts(current["end_ts"]),
                    _gc_iso_ts(current["gc_eligible_at"]))
        if len(rows) > 1:
            suffix += " history=%d" % len(rows)
        if eligible_count and not (state == "gc-eligible" and eligible_count == 1):
            suffix += " gc_eligible_versions=%d" % eligible_count
        if pending_count and not (state == "pending" and pending_count == 1):
            suffix += " pending_versions=%d" % pending_count
        if current.get("is_sparse"):
            suffix += " sparse_children=%s/%s" % (
                current.get("present_child_count"),
                current.get("child_manifest_count"))

        size_field = _gc_fmt_bytes(current["size"])
        if suffix:
            size_field = "%-10s" % size_field
        print("  %-*s %-11s digest=%s size=%s%s"
              % (name_width, name, state, current["digest"],
                 size_field, suffix))

    if only_problems and not displayed:
        print("  (no expired, pending-GC or historical tag version)")

    blobs = result["blobs"]
    print("")
    print("### blobs")
    print("  check=%s registry_token=%s unique=%d present=%d missing=%d"
          " size_mismatch=%d unchecked=%d skipped=%d bytes=%s"
          % ("on" if blobs["checked"] else "off", blobs["registry_token"],
             blobs["unique"], blobs["present"], blobs["missing"],
             blobs["size_mismatch"], blobs["unchecked"], blobs["skipped"],
             _gc_fmt_bytes(blobs["bytes_referenced"])))
    if not blobs["checked"]:
        print("  (metadata only: --no-blob-check)")
    for item in blobs["items"]:
        if item["status"] in ("present", "skipped"):
            continue
        print("  %-13s %s expected=%s actual=%s tags=%s manifests=%s"
              % (item["status"].upper(), item["digest"],
                 _gc_fmt_bytes(item["expected_size"]),
                 _gc_fmt_bytes(item["actual_size"]),
                 ",".join(item["tags"]) or "-",
                 ",".join(item["manifests"]) or "-"))
        if item.get("detail"):
            print("                detail=%s" % item["detail"])

    if result["sparse_manifests"]:
        print("")
        print("### sparse manifests (child manifests absent, not blob deletion)")
        for item in result["sparse_manifests"]:
            print("  parent=%s missing_child=%s tags=%s%s"
                  % (item["parent"], item["digest"],
                     ",".join(item["tags"]) or "-",
                     " (%s)" % item["error"] if item.get("error") else ""))

    if result["manifest_errors"]:
        print("")
        print("### manifest errors")
        for item in result["manifest_errors"]:
            print("  digest=%s tag=%s error=%s"
                  % (item["digest"], item["tag"], item["error"]))

    logs = result["logs"]
    if logs is not None:
        print("")
        print("### tag/policy audit log (last %d days)" % logs["window_days"])
        if logs["unavailable"]:
            print("  unavailable: %s" % logs["unavailable"])
        else:
            if not logs["counts"]:
                print("  no matching entries")
            else:
                print("  " + ", ".join("%s=%d" % (k, v)
                                       for k, v in sorted(logs["counts"].items())))
                for event in logs["events"][:20]:
                    print("  %s  %-32s tag=%s performer=%s"
                          % (event["datetime"], event["kind"],
                             event["tag"] or "-", event["performer"] or "-"))

    print("")
    print("VERDICT: %s" % result["verdict"])
    if result["problems"]:
        for problem in result["problems"]:
            print("  - %s" % problem["message"])
    if result["warnings"]:
        print("WARNINGS (expired tags only; informational):")
        for warning in result["warnings"]:
            print("  - %s" % warning["message"])
    if tags["gc_eligible"]:
        print("  - %d tag(s) are already eligible for GC (informational, not a failure)"
              % tags["gc_eligible"])
    if not result["blobs"]["checked"] and result["blobs"]["unique"]:
        print("  - blob presence was not checked (--no-blob-check); verdict is INCOMPLETE")
    if result["blobs"]["unchecked"]:
        print("  - %d blob(s) could not be checked; verdict is INCOMPLETE, not OK"
              % result["blobs"]["unchecked"])
    if result["sparse_manifests"]:
        print("  - %d sparse child manifest(s) absent (informational, not blob deletion)"
              % len(result["sparse_manifests"]))


def cmd_gc_audit(registry_url, Port, imageName, username=None, password=None,
                 token=None, json_output=False, only_problems=False,
                 blob_check=True, max_tags=200, logs_days=0, jobs=8,
                 fail_on_problem=False, show_tags=False, emit=True,
                 return_result=False):
    """
    Read-only GC / blob audit for ONE repository.

    The Quay API exposes no deleted-blob history and no per-repository GC
    timestamp.  This command reconstructs what can be known:
      * repository state and the namespace time-machine window;
      * repository/organization auto-prune policies;
      * tags, including expired ones still present, and their GC-eligibility;
      * every blob referenced by those tags, checked with HEAD /v2/.../blobs/...;
      * sparse manifest-list children and manifest metadata errors;
      * optionally, recent tag-deletion audit entries.

    With emit=False the function returns (exit_code, result) when
    return_result=True, so the org-wide batch mode can aggregate repositories
    without re-parsing its own text/JSON output.
    """
    def _ret(code, result=None):
        return (code, result) if return_result else code

    imageName = imageName.strip("/")
    if "/" not in imageName:
        printstderr("** gc-audit needs -i <namespace/repository> (got %r)" % imageName)
        return _ret(2)
    try:
        max_tags = max(0, int(max_tags))
    except (TypeError, ValueError):
        max_tags = 200
    try:
        logs_days = max(0, int(logs_days))
    except (TypeError, ValueError):
        logs_days = 0

    org = imageName.split("/", 1)[0]
    repo_path = quote(imageName, safe='/')
    r = api_get(registry_url, Port, "/api/v1/repository/" + repo_path,
                username, password, token, params={"includeTags": "false"})
    if r.status_code != 200:
        printstderr("** gc-audit: cannot read repository %s (HTTP %d): %s"
                    % (imageName, r.status_code, (r.text or "")[:200]))
        return _ret(2)
    try:
        repo_data = r.json()
    except ValueError:
        printstderr("** gc-audit: repository API returned invalid JSON")
        return _ret(2)

    state = repo_data.get("state")
    tag_expiration_s = repo_data.get("tag_expiration_s")
    try:
        tag_expiration_s = int(tag_expiration_s) if tag_expiration_s is not None else None
    except (TypeError, ValueError):
        tag_expiration_s = None

    def _policies(path):
        rr = api_get(registry_url, Port, path, username, password, token)
        if rr.status_code != 200:
            return {"policies": [], "error": "HTTP %d" % rr.status_code}
        try:
            return {"policies": rr.json().get("policies") or [], "error": None}
        except ValueError:
            return {"policies": [], "error": "invalid JSON"}

    retention = {
        "repository": _policies("/api/v1/repository/" + repo_path + "/autoprunepolicy/"),
        "organization": _policies("/api/v1/organization/" + quote(org, safe='')
                                    + "/autoprunepolicy/"),
    }

    tags = []
    page = 1
    truncated = False
    while True:
        rr = api_get(
            registry_url, Port,
            "/api/v1/repository/" + repo_path + "/tag/",
            username, password, token,
            params={"onlyActiveTags": "false", "limit": 100, "page": page},
        )
        if rr.status_code != 200:
            printstderr("** gc-audit: cannot list tags (HTTP %d): %s"
                        % (rr.status_code, (rr.text or "")[:200]))
            return _ret(2)
        try:
            data = rr.json()
        except ValueError:
            printstderr("** gc-audit: tag API returned invalid JSON")
            return _ret(2)
        chunk = data.get("tags") or []
        for tag in chunk:
            if max_tags and len(tags) >= max_tags:
                truncated = True
                break
            tags.append(tag)
        if truncated or not data.get("has_additional"):
            break
        page += 1
        if page > 1000:
            truncated = True
            break

    now_s = time.time()
    tag_items = []
    for tag in tags:
        end_ts = tag.get("end_ts")
        try:
            end_ts = float(end_ts) if end_ts is not None else None
        except (TypeError, ValueError):
            end_ts = None
        active = end_ts is None or end_ts > now_s
        eligible_at = None
        gc_eligible = False
        if end_ts is not None and tag_expiration_s is not None:
            eligible_at = end_ts + tag_expiration_s
            gc_eligible = eligible_at <= now_s
        tag_items.append({
            "name": tag.get("name"),
            "digest": tag.get("manifest_digest"),
            "size": tag.get("size"),
            "end_ts": end_ts,
            "expiration": tag.get("expiration"),
            "active": active,
            "gc_eligible": gc_eligible,
            "gc_eligible_at": eligible_at,
            "immutable": tag.get("immutable"),
            "is_sparse": tag.get("is_sparse"),
            "present_child_count": tag.get("present_child_count"),
            "child_manifest_count": tag.get("child_manifest_count"),
        })

    v2token = None
    v2mode = "disabled"
    if blob_check:
        v2token, v2mode = _gc_v2_token_for_repo(
            registry_url, Port, imageName, username, password, token)
        if v2token is None and token:
            # -T may itself be a registry JWT; try it rather than giving up.
            v2token, v2mode = token, "raw -T bearer"
        if v2token is None:
            printstderr("** gc-audit: no /v2 pull token (%s); blobs will be UNCHECKED"
                        % v2mode)

    ctx = {
        "registry_url": registry_url,
        "port": Port,
        "image_name": imageName,
        "username": username,
        "password": password,
        "token": token,
        "v2token": v2token,
        "cache": {},
        "blob_refs": {},
        "missing_children": {},
        "manifest_child_errors": {},
        "manifest_errors": [],
    }
    for tag_item in tag_items:
        if tag_item["digest"]:
            _gc_walk_manifest(ctx, tag_item["digest"], tag_item["name"],
                              tag_active=tag_item["active"])
        else:
            ctx["manifest_errors"].append({
                "digest": None, "tag": tag_item["name"],
                "active": tag_item["active"],
                "error": "tag has no manifest digest",
            })

    blob_results = {}
    if blob_check:
        targets = [d for d, ref in ctx["blob_refs"].items() if not ref["remote"]]
        if v2token is not None:
            workers = max(1, int(jobs))
            with ThreadPoolExecutor(max_workers=workers) as pool:
                futures = {
                    pool.submit(_gc_head_blob, registry_url, Port, imageName, d,
                                v2token): d
                    for d in targets
                }
                for future in as_completed(futures):
                    digest = futures[future]
                    try:
                        blob_results[digest] = future.result()
                    except Exception as exc:  # noqa: BLE001 - audit must continue
                        blob_results[digest] = {
                            "status": "unchecked", "size": None,
                            "detail": "worker exception: %s" % exc,
                        }
        else:
            for digest in targets:
                blob_results[digest] = {
                    "status": "unchecked", "size": None,
                    "detail": "no /v2 pull token (%s)" % v2mode,
                }
        for digest, ref in ctx["blob_refs"].items():
            if ref["remote"]:
                blob_results[digest] = {
                    "status": "unchecked", "size": None,
                    "detail": "foreign layer (urls) -- not stored locally",
                }
    else:
        for digest in ctx["blob_refs"]:
            blob_results[digest] = {
                "status": "skipped", "size": None, "detail": "--no-blob-check",
            }

    blob_items = []
    counts = {"present": 0, "missing": 0, "size_mismatch": 0,
              "unchecked": 0, "skipped": 0}
    bytes_referenced = 0
    for digest, ref in ctx["blob_refs"].items():
        result = blob_results.get(digest, {
            "status": "unchecked", "size": None, "detail": "not checked",
        })
        status = result["status"]
        expected = ref["size"]
        actual = result.get("size")
        if status == "present" and expected is not None and actual is not None \
                and expected != actual:
            status = "size_mismatch"
            result["detail"] = "expected %d bytes, got %d" % (expected, actual)
        counts[status] = counts.get(status, 0) + 1
        if expected is not None:
            bytes_referenced += expected
        tag_refs = ref["tag_refs"]
        tags_for_blob = sorted({tag for tag, _active in tag_refs})
        active_tags = sorted({tag for tag, active in tag_refs if active})
        blob_items.append({
            "digest": digest,
            "status": status,
            "expected_size": expected,
            "actual_size": actual,
            "remote": ref["remote"],
            "tags": tags_for_blob,
            "active_tags": active_tags,
            "expired_tags": [tag for tag in tags_for_blob
                             if tag not in active_tags],
            "manifests": sorted(ref["manifests"]),
            "kinds": sorted(ref["kinds"]),
            "detail": result.get("detail"),
        })
    blob_items.sort(key=lambda item: (
        {"missing": 0, "size_mismatch": 1, "unchecked": 2,
         "present": 3, "skipped": 4}.get(item["status"], 9),
        -(item["expected_size"] or 0),
        item["digest"],
    ))

    problems = []
    warnings = []
    for item in blob_items:
        target = problems if item["active_tags"] else warnings
        tag_list = item["active_tags"] or item["expired_tags"]
        extra = ""
        if item["active_tags"] and item["expired_tags"]:
            extra = " (also referenced by expired tag(s): %s)" % ", ".join(
                item["expired_tags"])
        elif not item["active_tags"]:
            extra = " (expired tags only)"
        if item["status"] == "missing":
            target.append({
                "kind": "missing_blob",
                "digest": item["digest"],
                "tags": tag_list,
                "active_tags": item["active_tags"],
                "expired_tags": item["expired_tags"],
                "message": "blob %s referenced by %s is missing from storage%s"
                           % (item["digest"], ", ".join(tag_list) or "?", extra),
            })
        elif item["status"] == "size_mismatch":
            target.append({
                "kind": "size_mismatch",
                "digest": item["digest"],
                "tags": tag_list,
                "active_tags": item["active_tags"],
                "expired_tags": item["expired_tags"],
                "message": "blob %s has size %s, expected %s%s"
                           % (item["digest"], _gc_fmt_bytes(item["actual_size"]),
                              _gc_fmt_bytes(item["expected_size"]), extra),
            })
    for error in ctx["manifest_errors"]:
        target = problems if error.get("active", True) else warnings
        target.append({
            "kind": "manifest_error",
            "digest": error["digest"],
            "tags": [error["tag"]],
            "message": "manifest %s (tag %s) is unreadable: %s"
                       % (error["digest"], error["tag"], error["error"]),
        })

    sparse_manifests = [
        {"parent": item["parent"], "digest": item["digest"],
         "tags": sorted(item["tags"]), "error": item.get("error")}
        for item in ctx["missing_children"].values()
    ]

    logs = _gc_fetch_logs(registry_url, Port, imageName, username, password,
                          token, logs_days) if logs_days > 0 else None

    checked_blobs = counts["present"] + counts["missing"] + counts["size_mismatch"]
    if problems:
        verdict = "PROBLEM"
    elif blob_items and (not blob_check or counts["unchecked"] > 0 or v2token is None):
        verdict = "INCOMPLETE"
    else:
        verdict = "OK"

    tag_groups = {}
    for item in tag_items:
        tag_groups.setdefault(item["name"] or "?", []).append(item)
    result = {
        "repository": imageName,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "state": state,
        "is_public": repo_data.get("is_public"),
        "tag_expiration_s": tag_expiration_s,
        "retention": retention,
        "tags": {
            "total": len(tag_items),
            "unique_names": len(tag_groups),
            "active": sum(1 for item in tag_items if item["active"]),
            "active_names": sum(
                1 for rows in tag_groups.values() if any(item["active"] for item in rows)),
            "expired_rows": sum(1 for item in tag_items if not item["active"]),
            "expired_pending_gc": sum(
                1 for item in tag_items if (not item["active"]) and not item["gc_eligible"]),
            "pending_rows": sum(
                1 for item in tag_items if (not item["active"]) and not item["gc_eligible"]),
            "gc_eligible": sum(1 for item in tag_items if item["gc_eligible"]),
            "gc_eligible_rows": sum(1 for item in tag_items if item["gc_eligible"]),
            "max_tags": max_tags,
            "truncated": truncated,
            "items": tag_items,
        },
        "blobs": {
            "checked": blob_check,
            "registry_token": v2mode,
            "unique": len(blob_items),
            "present": counts["present"],
            "missing": counts["missing"],
            "size_mismatch": counts["size_mismatch"],
            "unchecked": counts["unchecked"],
            "skipped": counts["skipped"],
            "checked_total": checked_blobs,
            "bytes_referenced": bytes_referenced,
            "items": blob_items,
        },
        "sparse_manifests": sparse_manifests,
        "manifest_errors": ctx["manifest_errors"],
        "logs": logs,
        "problems": problems,
        "warnings": warnings,
        "verdict": verdict,
    }

    if emit:
        if json_output:
            print(json.dumps(result, indent=2, sort_keys=False))
        else:
            _gc_print_text(result, only_problems=only_problems,
                           show_tags=show_tags)

    code = 1 if (fail_on_problem and problems) else 0
    return _ret(code, result)


def cmd_gc_audit_all(registry_url, Port, org, username=None, password=None,
                     token=None, json_output=False, only_problems=False,
                     blob_check=True, max_tags=200, logs_days=0, jobs=8,
                     fail_on_problem=False, show_tags=False, repo_jobs=4):
    """
    Org-wide gc-audit: enumerate every repository of -o ORG and run the same
    read-only audit on each one, then print a per-repository summary and totals.
    """
    repos, _pages, truncated = quay_list_org_repos(
        registry_url, Port, org, username, password, token)
    if not repos:
        if truncated:
            printstderr("** gc-audit --all-repos: could not enumerate repositories "
                        "of %s" % org)
            return 2
        printstderr("# gc-audit --all-repos: no repository found in %s" % org)
        return 0

    repos = sorted(set(repos))
    summaries = []
    errors = []
    totals = {
        "repositories": len(repos),
        "tags_rows": 0,
        "tags_unique_names": 0,
        "tags_active_names": 0,
        "tags_gc_eligible_rows": 0,
        "tags_pending_rows": 0,
        "tags_expired_rows": 0,
        "blobs_unique": 0,
        "blobs_present": 0,
        "blobs_missing": 0,
        "blobs_size_mismatch": 0,
        "blobs_unchecked": 0,
        "blobs_skipped": 0,
        "bytes_referenced": 0,
    }

    repo_jobs = max(1, int(repo_jobs))
    outcomes = {}

    def _run_one(repo, index):
        if repo_jobs <= 1:
            printstderr("# gc-audit [%d/%d] %s" % (index, len(repos), repo))
        code, audited = cmd_gc_audit(
            registry_url, Port, repo, username, password, token,
            json_output=False, only_problems=False, blob_check=blob_check,
            max_tags=max_tags, logs_days=logs_days, jobs=jobs,
            fail_on_problem=False, show_tags=False, emit=False,
            return_result=True,
        )
        return {"code": code, "result": audited, "exception": None}

    if repo_jobs <= 1:
        for index, repo in enumerate(repos, 1):
            try:
                outcomes[repo] = _run_one(repo, index)
            except Exception as exc:  # noqa: BLE001 - one repo must not stop the batch
                outcomes[repo] = {
                    "code": 2, "result": None,
                    "exception": "repository audit crashed: %s" % exc,
                }
    else:
        with ThreadPoolExecutor(max_workers=repo_jobs) as pool:
            futures = {
                pool.submit(_run_one, repo, 0): repo
                for repo in repos
            }
            done = 0
            for future in as_completed(futures):
                repo = futures[future]
                done += 1
                try:
                    outcomes[repo] = future.result()
                except Exception as exc:  # noqa: BLE001
                    outcomes[repo] = {
                        "code": 2, "result": None,
                        "exception": "repository audit crashed: %s" % exc,
                    }
                printstderr("# gc-audit [%d/%d] done %s" % (done, len(repos), repo))

    # Process results in sorted repository order, even though the worker
    # completions are unordered.
    for repo in repos:
        outcome = outcomes.get(repo) or {
            "code": 2, "result": None, "exception": "no audit result",
        }
        if outcome["exception"] or outcome["result"] is None:
            reason = outcome["exception"] or (
                "repository audit failed (exit %d)" % outcome["code"])
            errors.append({"repository": repo, "error": reason})
            continue

        result = outcome["result"]
        tags = result["tags"]
        blobs = result["blobs"]
        summary = {
            "repository": repo,
            "state": result["state"],
            "verdict": result["verdict"],
            "problems": len(result["problems"]),
            "warnings": len(result["warnings"]),
            "tag_expiration_s": result["tag_expiration_s"],
            "tags": {
                "rows": tags["total"],
                "unique_names": tags["unique_names"],
                "active_names": tags["active_names"],
                "gc_eligible_rows": tags.get("gc_eligible_rows",
                                              tags["gc_eligible"]),
                "pending_rows": tags.get("pending_rows",
                                         tags["expired_pending_gc"]),
                "expired_rows": tags["expired_rows"],
            },
            "blobs": {
                "unique": blobs["unique"],
                "present": blobs["present"],
                "missing": blobs["missing"],
                "size_mismatch": blobs["size_mismatch"],
                "unchecked": blobs["unchecked"],
                "skipped": blobs["skipped"],
                "bytes_referenced": blobs["bytes_referenced"],
            },
            "logs": (result["logs"]["counts"] if result["logs"] else None),
        }
        summaries.append(summary)
        totals["tags_rows"] += summary["tags"]["rows"]
        totals["tags_unique_names"] += summary["tags"]["unique_names"]
        totals["tags_active_names"] += summary["tags"]["active_names"]
        totals["tags_gc_eligible_rows"] += summary["tags"]["gc_eligible_rows"]
        totals["tags_pending_rows"] += summary["tags"]["pending_rows"]
        totals["tags_expired_rows"] += summary["tags"]["expired_rows"]
        totals["blobs_unique"] += summary["blobs"]["unique"]
        totals["blobs_present"] += summary["blobs"]["present"]
        totals["blobs_missing"] += summary["blobs"]["missing"]
        totals["blobs_size_mismatch"] += summary["blobs"]["size_mismatch"]
        totals["blobs_unchecked"] += summary["blobs"]["unchecked"]
        totals["blobs_skipped"] += summary["blobs"]["skipped"]
        totals["bytes_referenced"] += summary["blobs"]["bytes_referenced"]

    problems_repos = sum(1 for s in summaries if s["problems"])
    warnings_repos = sum(1 for s in summaries if s["warnings"])
    incomplete_repos = sum(1 for s in summaries if s["verdict"] == "INCOMPLETE")
    with_findings = sum(
        1 for s in summaries
        if s["problems"] or s["warnings"] or s["verdict"] != "OK")
    with_findings += len(errors)

    if errors or problems_repos:
        verdict = "PROBLEM"
    elif incomplete_repos:
        verdict = "INCOMPLETE"
    else:
        verdict = "OK"

    aggregate = {
        "org": org,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "repositories": summaries,
        "errors": errors,
        "totals": totals,
        "with_findings": with_findings,
        "problems_repositories": problems_repos,
        "warning_repositories": warnings_repos,
        "incomplete_repositories": incomplete_repos,
        "truncated": truncated,
        "verdict": verdict,
    }

    if json_output:
        print(json.dumps(aggregate, indent=2, sort_keys=False))
    else:
        print("")
        print("### gc-audit: %s" % org)
        repo_width = max(
            [len(s["repository"]) for s in summaries]
            + [len(e["repository"]) for e in errors] + [1])
        shown = 0
        if errors:
            print("")
            print("### repositories with errors")
            for item in errors:
                print("  %s: %s" % (item["repository"], item["error"]))
                shown += 1

        for summary in summaries:
            if only_problems and not (summary["problems"] or summary["warnings"]
                                      or summary["verdict"] != "OK"):
                continue
            status = summary["verdict"]
            if status == "OK" and summary["warnings"]:
                status = "OK(warn)"
            print("  %-*s %-11s tags rows=%d names=%d active=%d gc=%d | "
                  "blobs unique=%d present=%d missing=%d mismatch=%d "
                  "unchecked=%d | %s"
                  % (repo_width, summary["repository"], status,
                     summary["tags"]["rows"], summary["tags"]["unique_names"],
                     summary["tags"]["active_names"],
                     summary["tags"]["gc_eligible_rows"],
                     summary["blobs"]["unique"], summary["blobs"]["present"],
                     summary["blobs"]["missing"],
                     summary["blobs"]["size_mismatch"],
                     summary["blobs"]["unchecked"],
                     _gc_fmt_bytes(summary["blobs"]["bytes_referenced"])))
            shown += 1
        if only_problems and shown == 0:
            print("  (no repository with findings)")

        print("")
        print("### summary: %s" % org)
        print("  repositories=%d with_findings=%d errors=%d"
              % (len(repos), with_findings, len(errors)))
        print("  tags rows=%d unique_names=%d active_names=%d "
              "gc_eligible_rows=%d pending_rows=%d"
              % (totals["tags_rows"], totals["tags_unique_names"],
                 totals["tags_active_names"], totals["tags_gc_eligible_rows"],
                 totals["tags_pending_rows"]))
        print("  blobs unique(repo-sum)=%d present=%d missing=%d "
              "size_mismatch=%d unchecked=%d skipped=%d"
              % (totals["blobs_unique"], totals["blobs_present"],
                 totals["blobs_missing"], totals["blobs_size_mismatch"],
                 totals["blobs_unchecked"], totals["blobs_skipped"]))
        print("  bytes(repo-sum)=%s" % _gc_fmt_bytes(totals["bytes_referenced"]))
        if truncated:
            print("  ** repository list was truncated by the API/page limit")
        print("")
        print("VERDICT: %s" % verdict)
        print("  - all totals are sums per repository: a shared blob or tag name "
              "is counted once per repository, not once globally.")

    if errors:
        return 2
    if fail_on_problem and problems_repos:
        return 1
    return 0


def cmd_list_organizations(registry_url, Port, username=None, password=None,
                           token=None, all_orgs=False, json_output=False):
    """
    List organizations visible to the credential.

    Default: GET /api/v1/user/ -> organizations the user is a member of (plus
    configured public namespaces).  --all: GET /api/v1/superuser/organizations/
    -> every organization; this needs a superuser and a fresh login.
    """
    if all_orgs:
        apipath = "/api/v1/superuser/organizations/"
        source = "superuser"
    else:
        apipath = "/api/v1/user/"
        source = "current_user"

    r = api_get(registry_url, Port, apipath, username, password, token)
    if r.status_code != 200:
        describe_response(r, apipath)
        if r.status_code == 403 and all_orgs:
            printstderr("   -> --all requires a superuser credential and a fresh login; "
                        "-T remains the reliable path.")
        return 1
    try:
        data = r.json()
    except ValueError:
        printstderr("** list-organizations: API returned invalid JSON")
        return 1

    orgs = data.get("organizations") or []
    if not isinstance(orgs, list):
        orgs = []

    if json_output:
        print(json.dumps({
            "source": source,
            "organizations": orgs,
        }, indent=2, sort_keys=False))
        return 0

    title = "all organizations (superuser)" if all_orgs else "organizations (current user)"
    print("### %s" % title)
    if not orgs:
        print("  none")
        return 0

    rows = []
    for org in orgs:
        if not isinstance(org, dict):
            continue
        name = org.get("name") or org.get("username") or "?"
        flags = []
        if org.get("is_org_admin"):
            flags.append("admin")
        if org.get("public"):
            flags.append("public")
        rows.append((name, ",".join(flags)))
    name_width = max([len(name) for name, _flags in rows] or [1])
    for name, flags in sorted(rows):
        line = "  %-*s" % (name_width, name)
        if flags:
            line += "  " + flags
        print(line)
    return 0


def lookup_credentials(registry_host, port="443"):
    """
    FIX (root cause of the 'silent empty / 401' behaviour):
    the original code looked the registry up ONLY as "<host>:<port>", but
    podman/docker store the key as the bare hostname (optionally with an
    https:// scheme). So the lookup silently returned {} and every call fell
    back to anonymous -> empty catalog / 401.
    Try, in order: bare host, host:port, both with scheme, and suffix match.
    NEVER prints or logs the secret. Returns a LIST of (dict, src) candidates.
    """
    found = []
    candidates = []
    for h in (registry_host,
              registry_host + ":" + str(port),
              registry_host.replace("https://", "").replace("http://", ""),
              "https://" + registry_host,
              "https://" + registry_host.replace("https://", "").replace("http://", "")):
        if h and h not in candidates:
            candidates.append(h)

    # FIX: podman does NOT read ~/.docker/config.json first -- it uses its own
    # store. The docker config can hold a DIFFERENT (older, or split-on-':')
    # entry, which is what made the tool 401 while `podman search` succeeded.
    # Order now mirrors podman's own precedence, and we collect EVERY match
    # rather than returning the first, so the caller can try them all.
    # podman's own precedence (verified on this host: the runtime dir store is
    # the one `podman login` writes; ~/.config/containers/auth.json does NOT
    # exist here and is only a documented fallback).
    for path in (os.environ.get("REGISTRY_AUTH_FILE", ""),
                 os.path.expandvars("$XDG_RUNTIME_DIR/containers/auth.json"),
                 "~/.config/containers/auth.json",
                 "~/.docker/config.json"):
        if not path:
            continue
        path = os.path.expanduser(path)
        if not os.path.exists(path):
            continue
        try:
            with open(path) as f:
                auths = json.load(f).get("auths", {})
        except Exception:
            continue
        # unambiguous label: a path is not a secret, and 'containers/auth.json'
        # used to hide WHICH file (XDG runtime vs ~/.config) was read.
        ap = os.path.abspath(os.path.expanduser(path))
        home = os.path.expanduser("~")
        if ap.startswith(home + "/"):
            src = "~/" + ap[len(home) + 1:]
        elif ap.startswith("/run/user/"):
            src = "$XDG_RUNTIME_DIR" + ap[len("/run/user"):]
        else:
            src = ap
        # exact matches first, but COLLECT all (podman may hold a different,
        # working entry than the docker config)
        seen = set()
        for c in candidates:
            if c in auths:
                d = _extract_pair(auths[c])
                if d and d.get("raw") not in seen:
                    seen.add(d.get("raw"))
                    found.append((d, src))
        # then: suffix match (handles a stored ":443" or scheme)
        for stored, val in auths.items():
            s = stored.replace("https://", "").replace("http://", "").rstrip("/")
            for c in candidates:
                cs = c.replace("https://", "").replace("http://", "").rstrip("/")
                if s == cs or s == cs + ":443":
                    d = _extract_pair(val)
                    if d and d.get("raw") not in seen:
                        seen.add(d.get("raw"))
                        found.append((d, src))
    return found


def _extract_raw_b64(reg_data):
    """
    fork FIX (this is the real reason the tool failed while `podman search`
    worked): a credential store entry may hold a value that is NOT a plain
    'login:password' pair (OAuth identity token, credential-helper placeholder,
    robot token...). Decoding it and splitting on ':' then INVENTS a login and a
    password, and the registry rightly answers 401 'Invalid username or
    password'. podman does not split: it replays the stored base64 verbatim as
    the Basic header. Do exactly the same -- byte-identical to podman.
    Returns the raw base64 string (never printed).
    """
    if not isinstance(reg_data, dict):
        return None
    raw = reg_data.get("auth")
    if not raw:
        return None
    try:
        base64.b64decode(raw, validate=True)
    except Exception:
        return None
    # only usable as Basic if it decodes to something containing a ':'
    try:
        dec = base64.b64decode(raw).decode("utf-8", "replace")
    except Exception:
        return None
    return raw if ":" in dec else None


def pair_shape(reg_data):
    """
    fork: report the SHAPE of the stored credential so the operator can tell a
    robot token from an LDAP login WITHOUT ever seeing either. Prints lengths
    and character classes only.
    """
    raw = reg_data.get("auth") if isinstance(reg_data, dict) else None
    if not raw:
        return "no 'auth' key (identitytoken only? -> /api/v1 needs -T token)"
    try:
        dec = base64.b64decode(raw).decode("utf-8", "replace")
    except Exception:
        return "undecodable 'auth'"
    if ":" not in dec:
        return "single token, no ':' (%d chars) -> NOT a login:password pair" % len(dec)
    u, p = dec.split(":", 1)
    def cls(s):
        if s.isdigit():
            return "all-digits"
        if re.fullmatch(r"[0-9a-f]{8,}", s):
            return "hex-like"
        if re.fullmatch(r"[A-Za-z0-9._-]{16,}", s):
            return "opaque-random"
        return "human-readable"
    return ("login=%d chars (%s), secret=%d chars (%s)"
            % (len(u), cls(u), len(p), cls(p)))


def _extract_pair(reg_data):
    """
    fork: return {'username','password','raw','shape'}. 'raw' is the stored
    base64 to be replayed VERBATIM (podman-identical) and is the preferred
    form; splitting is only a fallback for stores that keep explicit
    username/password keys.
    """
    if not isinstance(reg_data, dict):
        return None
    out = {}
    raw = _extract_raw_b64(reg_data)
    if raw:
        out["raw"] = raw
        out["shape"] = pair_shape(reg_data)
        try:
            dec = base64.b64decode(raw).decode("utf-8", "replace")
            if ":" in dec:
                u, p = dec.split(":", 1)
                out["username"], out["password"] = u, p
        except Exception:
            pass
        return out
    if "auth" in reg_data:
        # auth present but not a usable login:password -> keep raw anyway
        return {"raw": reg_data["auth"], "shape": pair_shape(reg_data)}
    if "username" in reg_data and "password" in reg_data:
        return {"username": reg_data["username"], "password": reg_data["password"],
                "shape": "explicit username/password keys"}
    return None


def _natural_key(value):
    """Sort postgresql-9 before postgresql-10/12, case-insensitively."""
    return [int(part) if part.isdigit() else part.lower()
            for part in re.split(r"(\d+)", str(value))]


def _search_json(response, what):
    """Parse a V1-search JSON body, or explain why it is not one."""
    ctype = (response.headers.get("Content-Type") or "").split(";")[0].strip().lower()
    try:
        data = response.json()
    except ValueError:
        printstderr("** %s did not return JSON (HTTP %d, Content-Type: %s)"
                    % (what, response.status_code, ctype or "?"))
        printstderr("   This registry does not implement the deprecated V1 search API")
        printstderr("   (Docker Hub redirects /v1/search to an HTML page).")
        return None
    if not isinstance(data, dict):
        printstderr("** %s returned unexpected JSON (%s)" % (what, type(data).__name__))
        return None
    return data


def cmd_search_v1(registry_url, Port, term, username=None, password=None,
                  token=None, pages_wanted=0, show_desc=False):
    """
    fork: the DEPRECATED registry V1 search API -- this is what
    `podman search <registry>/` actually calls, and on this Quay it is the
    ONLY working enumeration surface:
        /v2/_catalog  -> {"repositories":[]}   (superuser-only in practice)
        /v1/search    -> real results, but only WITH credentials (0 anonymous)
    Paginates via num_pages. Read-only.
    """
    base = _base_url(registry_url, Port)
    hdrs = {'Accept': 'application/json'}
    # basic_header() falls back to RAW_BASIC, so a verbatim blob with no usable
    # 'login:password' split still authenticates byte-identically to podman.
    if username is not None or RAW_BASIC:
        hdrs['Authorization'] = basic_header(username, password)
    elif token:
        hdrs['Authorization'] = "Bearer " + token

    # v1 is served over plain http on 80 in the spec, but Quay serves it on 443.
    # Do NOT follow redirects blindly: docker.io sends /v1/search to
    # www.docker.com, which answers 200 + HTML and used to crash on r.json().
    r = _http_session().get(base + "/v1/search", headers=hdrs,
                            params={"q": term or "", "n": 100}, timeout=30,
                            allow_redirects=False)
    if r.status_code in (301, 302, 307, 308):
        loc = urljoin(base + "/", r.headers.get("Location", ""))
        if not loc or urlparse(loc).netloc != urlparse(base).netloc:
            printstderr("** /v1/search redirects off-registry to %s"
                        % (loc or "an empty Location"))
            printstderr("   refusing to follow: this registry does not expose "
                        "the V1 search API")
            return None
        r = _http_session().get(loc, headers=hdrs, timeout=30)
    if not describe_response(r, "/v1/search?q=%r" % term):
        return None
    d = _search_json(r, "/v1/search?q=%r" % term)
    if d is None:
        return None
    results = list(d.get("results") or d.get("result") or [])
    npages = int(d.get("num_pages") or 1)
    page = int(d.get("page") or 1)

    # Collect all requested pages first, then print one sorted table.  The old
    # code printed page 1 with descriptions but later pages as bare names.
    pages_fetched = 1
    while page < npages and (pages_wanted == 0 or page < pages_wanted):
        page += 1
        rr = _http_session().get(base + "/v1/search", headers=hdrs,
                                  params={"q": term or "", "page": page, "n": 100},
                                  timeout=30)
        if rr.status_code != 200:
            printstderr("** page %d -> HTTP %d, stopping" % (page, rr.status_code))
            break
        dd = _search_json(rr, "/v1/search page %d" % page)
        if dd is None:
            break
        rs = dd.get("results") or dd.get("result") or []
        if not rs:
            break
        results.extend(rs)
        pages_fetched += 1

    # Deduplicate and sort naturally, so postgresql-9/10/12 are in numeric order.
    by_name = {}
    for item in results:
        name = item.get("name") or item.get("repo_name")
        if name:
            by_name[name] = item

    ordered = [by_name[name] for name in sorted(by_name, key=_natural_key)]

    print("### /v1/search q=%r  results=%d  pages=%d/%d"
          % (term or "*", len(ordered), pages_fetched, npages))
    if not ordered:
        print("  (no result)")
    else:
        rows = []
        for item in ordered:
            name = item.get("name") or item.get("repo_name") or "?"
            if "is_public" in item:
                visibility = "public" if item["is_public"] else "private"
            else:
                visibility = "-"
            description = (item.get("description") or "").replace("\n", " ").strip()
            if show_desc and len(description) > 80:
                description = description[:77] + "..."
            rows.append((name, visibility, description))

        name_width = max(len("NAME"), max(len(row[0]) for row in rows))
        vis_width = max(len("VIS"), max(len(row[1]) for row in rows))
        if show_desc:
            print(("  %-*s  %-*s  %s"
                   % (name_width, "NAME", vis_width, "VIS", "DESCRIPTION")).rstrip())
            for name, visibility, description in rows:
                line = "  %-*s  %-*s  %s" % (
                    name_width, name, vis_width, visibility, description)
                print(line.rstrip())
        else:
            print(("  %-*s  %-*s"
                   % (name_width, "NAME", vis_width, "VIS")).rstrip())
            for name, visibility, _description in rows:
                print(("  %-*s  %-*s"
                       % (name_width, name, vis_width, visibility)).rstrip())

    if debug and results:
        print("  entry keys: %s" % sorted(results[0].keys()))
    print("# total: %d result(s) from %d page(s)" % (len(ordered), pages_fetched))
    return ordered


def cmd_search_v2(registry_url, Port, term, username=None, password=None,
                  token=None, anonymous=False, max_pages=0):
    """Podman-style "V2 search": enumerate /v2/_catalog and filter locally.

    The Docker Registry V2 protocol has no search endpoint.  `podman search`
    falls back to paging through /v2/_catalog and matching repository names,
    and this command does the same.  The catalog contains no descriptions, so
    the output is a NAME column only.

    anonymous=True skips credentials entirely (anonymous token grant first,
    then a plain unauthenticated GET).  Without it, credentials supplied via
    -u/-p or a stored podman/docker credential are used when available; an
    empty credential set also ends up anonymous.
    """
    if anonymous:
        token = None
        anon_token, _ttl = _get_anonymous_token(registry_url, Port)
        if anon_token:
            token = anon_token
    elif token is None and (username is not None or password is not None):
        token = getToken(registry_url, username, password, Port)

    repositories, pages, truncated = _fetch_catalog_v2_pages(
        registry_url, Port, token=token, max_pages=max_pages)
    if repositories is None:
        return None

    needle = (term or "").lower()
    matches = sorted({repo for repo in repositories if needle in repo.lower()},
                     key=_natural_key)

    print("### /v2/_catalog q=%r  results=%d  pages=%d"
          % (term or "*", len(matches), pages))
    if not matches:
        print("  (no result)")
    else:
        name_width = max(len("NAME"), max(len(name) for name in matches))
        print(("  %-*s" % (name_width, "NAME")).rstrip())
        for name in matches:
            print(("  %-*s" % (name_width, name)).rstrip())
    print("# total: %d result(s) from %d catalog page(s)%s"
          % (len(matches), pages,
             " (truncated by --pages %d)" % max_pages if truncated else ""))
    return matches


def v2_credential_accepted(registry_url, Port, auth_header, timeout=15):
    """
    fork: validate one candidate WITHOUT ever printing it.
    FIX: must mirror getToken() EXACTLY (account= AND service=). Probing with
    only service= yields a spurious 401, which made this gate reject perfectly
    good credentials -- a self-inflicted regression that turned a working
    list-catalog (962 repos) back into an anonymous empty answer.
    """
    try:
        r = requests.get(_base_url(registry_url, Port) + "/v2/auth",
                         headers={'Accept': 'application/json',
                                  'Authorization': auth_header},
                         params={"service": registry_url},
                         timeout=timeout, allow_redirects=False)
        return r.status_code == 200 and "token" in (r.text or "")
    except Exception:
        return False


def v2_credential_accepted_account(registry_url, Port, auth_header, account, timeout=15):
    """getToken()-identical probe: account=<login> + service=<host>."""
    try:
        r = requests.get(_base_url(registry_url, Port) + "/v2/auth",
                         headers={'Accept': 'application/json',
                                  'Authorization': auth_header},
                         params={"account": account, "service": registry_url},
                         timeout=timeout, allow_redirects=False)
        return r.status_code == 200 and "token" in (r.text or "")
    except Exception:
        return False


def auth_header_for(d):
    """Build the Authorization value for one stored candidate (never printed)."""
    if not isinstance(d, dict):
        return None
    if d.get("raw"):
        return "Basic " + d["raw"]          # replayed VERBATIM, podman-identical
    if d.get("username") is not None:
        return basic_header(d.get("username"), d.get("password"))
    return None


API_HEADERS = None    # fork: header set for /api/v1, ONLY from explicit user input

# ---------------------------------------------------------------------------
# fork: the THIRD auth mode, the one the redhat-cop / infra.quay_configuration
# collection actually uses, and the one this tool was missing.
# Read it in module_utils/api_module.py ::
#
#     def authenticate(self):
#         # Retrieve the CSRF cookie and token from /csrf_token (Quay 3.16+)
#         GET  /csrf_token                      -> {"csrf_token": ...} + cookie
#         POST /api/v1/signin  X-CSRF-Token: ...  {"username","password"}
#                                              -> Set-Cookie: session=...
#                                              -> X-Next-CSRF-Token: ...
#         self.session.headers.update({"X-CSRF-Token": token})
#
# i.e. the modules log in through the WEB UI endpoint and then carry a SESSION
# COOKIE. They NEVER send HTTP Basic to /api/v1 -- which is exactly why your
# Ansible job can read robots/mirrors while this tool, Basic-only, gets 401
# invalid_token.  /v2 (docker registry protocol) is the only place Basic works.
#
# NOTE ON 'READ-ONLY': POST /api/v1/signin mutates NO registry object. It opens
# a session. Like any authenticated call it may touch user.last_accessed and it
# does create an audit/login event server-side. It never creates, changes or
# deletes an org, repo, robot or mirror.
# ---------------------------------------------------------------------------
SESSION = None      # requests.Session holding the Quay session cookie
SESSION_LOCK = threading.Lock()  # serialize shared-session GETs (gc-audit --all-repos)
CSRF = None         # X-CSRF-Token value for the current session


def web_login(registry_url, Port, username, password, timeout=25):
    """
    Establish a /api/v1 session exactly like APIModule.authenticate().
    Returns True/False. NEVER prints, logs or returns any secret or cookie.
    Credentials come from the caller (api_headers_for): either the operator
    passed them explicitly (-u/-p or QRC_USERNAME/QRC_PASSWORD), or -- BY
    DEFAULT -- the login:pass read from the credential store is replayed to
    POST /api/v1/signin (set QRC_ALLOW_STORE_WEB_LOGIN=0 to forbid that).
    WARNING: a failed /signin bumps invalid_login_attempts on that account,
    which is often a shared service account that also carries every mirror
    (--src-creds) -- a typo can lock mirroring platform-wide.
    """
    global SESSION, CSRF
    if not username:
        return False
    base = _base_url(registry_url, Port)
    s = requests.Session()
    s.headers.update({'Accept': '*/*'})
    csrf = None
    # 1) CSRF from /csrf_token (Quay 3.16+), else window.__token from / (<=3.15)
    try:
        r = s.get(base + "/csrf_token", timeout=timeout)
        if r.status_code == 200:
            csrf = r.json().get("csrf_token")
    except Exception:
        csrf = None
    if not csrf:
        try:
            r = s.get(base + "/", timeout=timeout)
            m = re.search(r"window\.__token\s*=\s*'(.*?)';", r.text)
            csrf = m.group(1) if m else None
        except Exception:
            csrf = None
    if not csrf:
        if debug:
            printstderr("! web login: no CSRF token obtained from /csrf_token or /")
        return False
    # 2) the web sign-in
    try:
        r = s.post(base + "/api/v1/signin",
                   headers={'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-CSRF-Token': csrf},
                   data=json.dumps({"username": username, "password": password}),
                   timeout=timeout, allow_redirects=False)
    except Exception as e:
        if debug:
            printstderr("! web login: signin request failed (%s)" % type(e).__name__)
        return False
    if r.status_code != 200:
        # report status + Quay's own error text only -- no credential involved
        if debug:
            printstderr("! web login: POST /api/v1/signin -> HTTP %d %s"
                        % (r.status_code, (r.text or '')[:140].replace('\n', ' ')))
        return False
    h = {k.lower(): v for k, v in r.headers.items()}
    CSRF = h.get("x-next-csrf-token", csrf)
    SESSION = s
    if debug:
        printstderr("! web login: session established (cookie + CSRF held in memory only)")
    return True


class _NoAuthResult:
    """
    fork: placeholder returned by api_get() when no /api/v1 credential is
    available. Looks like a requests.Response just enough for the callers
    (status_code + describe_response) without ever hitting the network.
    """
    status_code = 0
    url = "(not sent: no /api/v1 credential)"
    text = ""
    headers = {}


def api_headers_for(token=None, username=None, password=None, registry=None, port=None):
    """
    fork: /api/v1 (mirror config, robots, repo view) does NOT accept Basic on
    this Quay -- it answers 401 'invalid_token' even though the same blob is
    accepted on /v2/auth.

    Three supported modes, in order:
      1. -T token / QRC_TOKEN                 -> 'Authorization: Bearer ...'
         (the OAuth app token of the per-org 'ansible' application, synthese
          4.5/9.1 -- this is what quay_api_token.py hands to the modules)
      2. QRC_COOKIE='session=...'             -> browser session replay
      3. WEB LOGIN (NEW, this is what the Ansible collection does):
         -u/-p or QRC_USERNAME/QRC_PASSWORD  -> GET /csrf_token
                                             -> POST /api/v1/signin
                                             -> session cookie + X-CSRF-Token
         See module_utils/api_module.py::APIModule.authenticate(). The modules
         NEVER send HTTP Basic to /api/v1; they sign in to the web UI and carry
         a session. That is the whole difference with this tool, which was
         Basic-only.

    SECURITY: never derives or replays the /v2 stored blob as an API
    credential. Web login only happens with credentials the operator passes
    explicitly for it.
    """
    global API_HEADERS, RAW_BASIC
    if API_HEADERS is not None and not token and not os.environ.get("QRC_TOKEN") \
       and not os.environ.get("QRC_COOKIE") and not username:
        return API_HEADERS
    tok = token or os.environ.get("QRC_TOKEN")
    if tok:
        h = {'Accept': 'application/json', 'Authorization': "Bearer " + tok}
        API_HEADERS = h
        return h
    ck = os.environ.get("QRC_COOKIE")
    if ck:
        h = {'Accept': 'application/json', 'Cookie': ck}
        API_HEADERS = h
        return h
    # mode 3: web sign-in, exactly like the Ansible collection
    u = username or os.environ.get("QRC_USERNAME")
    p = password or os.environ.get("QRC_PASSWORD", "")
    if u and registry:
        # Credentials the operator passes explicitly override any stored blob,
        # otherwise basic_header()/web_login() would silently use the WRONG pair.
        if not CREDS_FROM_STORE and RAW_BASIC:
            # operator gave -u/-p explicitly on the command line: never let a
            # previously loaded store blob override it in basic_header().
            RAW_BASIC = None
            if debug:
                printstderr("- explicit -u/-p given; ignoring any stored blob")
        # Credentials auto-loaded from a credential file are replayed to the
        # WEB sign-in BY DEFAULT (ALLOW_STORE_WEB_LOGIN defaults to "1") --
        # this is the operator's own login:pass. Set QRC_ALLOW_STORE_WEB_LOGIN=0
        # to require explicit -u/-p or QRC_TOKEN instead. WARNING: a failed
        # /signin bumps invalid_login_attempts on that account, which is often
        # a shared service account that also carries every mirror
        # (--src-creds) -- a typo can lock mirroring platform-wide.
        # Credentials the operator passes explicitly for THIS run (-u/-p,
        # QRC_USERNAME) are used directly, exactly like the Ansible modules do.
        if CREDS_FROM_STORE and not ALLOW_STORE_WEB_LOGIN:
            if debug:
                printstderr("- web login skipped: credentials came from a credential "
                            "file and QRC_ALLOW_STORE_WEB_LOGIN=0 forbids replaying "
                            "them to POST /api/v1/signin; pass -u/-p explicitly or "
                            "unset QRC_ALLOW_STORE_WEB_LOGIN to allow it")
            return None
        if SESSION is not None or web_login(registry, port or 443, u, p):
            return {'Accept': 'application/json'}   # SESSION carries the cookie
        return None
    return None


def explain_api_auth_needed(registry_url):
    printstderr("** /api/v1 needs an OAuth/app token or a session cookie -- the stored")
    printstderr("   registry credential is a /v2 (docker protocol) credential and this")
    printstderr("   Quay refuses it on the API (401 invalid_token). I will not derive or")
    printstderr("   replay it in another form. Provide one of:")
    printstderr("     QRC_TOKEN=<token>   # the per-org 'ansible' OAuth token the Ansible")
    printstderr("                         # role uses (synthese 4.5 / 9.1), or a robot token")
    printstderr("     QRC_COOKIE='session=<...>'   # your browser session on this Quay")
