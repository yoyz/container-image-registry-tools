def _fetch_catalog_v2_pages(registry_url, Port, token=None, max_pages=0):
    """Fetch the catalog and return (repositories, pages_fetched, truncated).

    Follows the pagination Link headers.  ``max_pages=0`` means every page;
    ``truncated`` is True when that limit stopped the crawl before the last
    page.  Returns (None, 0, False) when the first page fails; a later-page
    failure keeps the repositories already collected.  Never raises on a bad
    page body.
    """
    if debug:
        printstderr("# fetch_catalog_v2")
    if checkhttpsconnection(registry_url,Port)==0:
        return None, 0, False

    # Authentication is carried by the Bearer token only; token=None means an
    # anonymous request.
    headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
    }
    if token:
        headers['Authorization'] = "Bearer "+token

    url_short=_base_url(registry_url, Port)
    url=url_short+"/v2/_catalog"

    if debug:
        log_python_request_curl_transform("GET",url,headers)

    response = _http_session().get(url, headers=headers, timeout=30)
    if response.status_code != 200:
        printstderr(f"Failed to get images: {response.status_code}")
        return None, 0, False

    try:
        images = json.loads(response.text)
    except json.JSONDecodeError:
        printstderr("Failed to parse JSON response")
        return None, 0, False

    repositories = list(images.get("repositories") or [])
    pages = 1

    while "Link" in response.headers and (max_pages <= 0 or pages < max_pages):
        next_re = re.search(r'<(.*)>', response.headers["Link"])
        if not next_re:
            break
        url = url_short + next_re.group(1)
        response = _http_session().get(url, headers=headers, timeout=30)
        if response.status_code != 200:
            printstderr(f"Failed to get next images: {response.status_code}")
            break
        try:
            images_next = json.loads(response.text)
        except json.JSONDecodeError:
            printstderr("Failed to parse JSON response for the next page")
            break
        repositories.extend(images_next.get("repositories") or [])
        pages += 1

    truncated = bool(max_pages > 0 and pages >= max_pages
                     and re.search(r'<(.*)>', response.headers.get("Link", "")))
    return repositories, pages, truncated


def fetch_catalog_v2(registry_url, username, password,Port,token=None,max_pages=0):
    """Fetch the registry catalog, following the pagination Link headers.

    The token is optional: when it is None the request is sent anonymously.
    Returns a dict like {"repositories": [...]}, or None on failure.
    """
    repositories, _pages, _truncated = _fetch_catalog_v2_pages(
        registry_url, Port, token=token, max_pages=max_pages)
    if repositories is None:
        return None
    return {"repositories": repositories}


def fetch_catalog_v2_token(registry_url,Port,token=None):
    """Backward-compatible wrapper: anonymous (token=None) or token-based catalog."""
    return fetch_catalog_v2(registry_url, None, None, Port, token)




    

