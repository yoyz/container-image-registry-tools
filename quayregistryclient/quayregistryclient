def _abort_on_ctrl_c(sig, frame):
    sys.stderr.write("\nAborted: nothing was deleted.\n")
    sys.stderr.flush()
    sys.exit(EXIT_ABORTED)


def delete_all_countdown(registry_url, Port, seconds=DELETE_ALL_COUNTDOWN):
    """Warn about the destructive action and give the user time to abort.

    The countdown is written on stderr and refreshed in place when stderr is a
    terminal. Ctrl+C exits with code 130 before any request is sent. The
    previous SIGINT handler is restored afterwards.
    """
    target = f"https://{registry_url}:{Port}"
    printstderr(f"About to delete ALL repositories of {target} in {seconds} seconds.")
    printstderr("Press Ctrl+C to abort.")

    previous_handler = None
    try:
        previous_handler = signal.signal(signal.SIGINT, _abort_on_ctrl_c)
    except (ValueError, OSError):
        # Not in the main thread: keep the current handler.
        pass

    interactive = sys.stderr.isatty()
    try:
        for remaining in range(seconds, 0, -1):
            line = f"  {remaining:2d}s remaining before deletion... (Ctrl+C to abort)"
            if interactive:
                sys.stderr.write("\r" + line)
            else:
                sys.stderr.write(line + "\n")
            sys.stderr.flush()
            time.sleep(1)
        if interactive:
            sys.stderr.write("\r" + " " * 70 + "\r")
        sys.stderr.write("Starting deletion now.\n")
        sys.stderr.flush()
    except KeyboardInterrupt:
        sys.stderr.write("\nAborted: nothing was deleted.\n")
        sys.stderr.flush()
        sys.exit(EXIT_ABORTED)
    finally:
        if previous_handler is not None:
            signal.signal(signal.SIGINT, previous_handler)


