def cmd_mirror_get(registry_url, Port, imageName, username=None, password=None, token=None):
    """
    GET /api/v1/repository/<org>/<repo>/mirror
    The ONLY place Quay hands you the decrypted upstream login + the real
    sync_status (as STRINGS, not the SQL integers), robot_username,
    external_reference and next_start_date.  (synthese 5.1 + 9.1)
    """
    apipath = "/api/v1/repository/" + quote(imageName.strip("/"), safe='/') + "/mirror"
    r = api_get(registry_url, Port, apipath, username, password, token)
    if not describe_response(r, imageName + " mirror config"):
        return None
    m = r.json()
    interesting = ("is_enabled", "sync_status", "sync_retries_remaining",
                   "sync_interval", "next_start_date", "external_reference",
                   "external_registry_username", "external_registry_config",
                   "robot_username", "mirror_type",
                   "skopeo_timeout_interval", "skopeo_timeout",
                   "creation_date", "last_update_date", "sync_start_date",
                   "sync_expiration_date")
    print("### mirror config: %s" % imageName)
    for k in interesting:
        if k in m:
            v = m[k]
            # THE mask: upstream login is a credential (Quay decrypts it here
            # for us). Never print it unless --show-secrets.
            if (k == "external_registry_username" and not SHOW_SECRETS
                    and v not in (None, "")):
                v = "[MASKED login, %d chars -- --show-secrets to reveal]" % len(v)
            if k == "external_registry_config" and isinstance(v, str):
                try:
                    v = json.loads(v)
                except ValueError:
                    pass
            print("  %-30s = %s" % (k, json.dumps(v) if not isinstance(v, str) else v))
    extra = [k for k in m if k not in interesting]
    if extra:
        print("  (other keys: %s)" % ", ".join(sorted(extra)))
    if SHOW_SECRETS is False:
        print("  [upstream login masked; --show-secrets to reveal -- it is the LDAP service account]")

    # ---- GC / retention (auto-prune) ----
    # Quay's garbage collection runs cluster-wide and the API exposes NO
    # per-repository GC timestamp. The per-repository GC signal is the
    # auto-prune (retention) policy, which decides which tags are eventually
    # pruned, plus the repository state (MARKED_FOR_DELETION = queued for GC).
    repo_path = quote(imageName.strip("/"), safe='/')
    org_name = imageName.split("/", 1)[0]
    print("")
    print("### garbage collection / retention (auto-prune)")
    for label, path in (
        ("repository", "/api/v1/repository/" + repo_path + "/autoprunepolicy/"),
        ("organization", "/api/v1/organization/" + quote(org_name, safe='/') + "/autoprunepolicy/"),
    ):
        r = api_get(registry_url, Port, path, username, password, token)
        if r.status_code == 200:
            try:
                policies = r.json().get("policies") or []
            except ValueError:
                policies = []
            if not policies:
                print("  %s policies: none" % label)
            else:
                print("  %s policies:" % label)
                for pol in policies:
                    print("    - uuid=%s method=%s value=%s tagPattern=%r tagPatternMatches=%s"
                          % (pol.get("uuid"), pol.get("method"), pol.get("value"),
                             pol.get("tagPattern"), pol.get("tagPatternMatches")))
        elif r.status_code == 404:
            print("  %s policies: unavailable (auto-prune disabled, no permission, "
                  "or namespace is not an organization)" % label)
        elif r.status_code == 0:
            print("  %s policies: not queried (no /api/v1 credential)" % label)
        else:
            print("  %s policies: HTTP %d" % (label, r.status_code))
    print("  note: GC is cluster-wide; the API exposes no per-repository GC timestamp.")
    print("        state=MARKED_FOR_DELETION (see repo-view) means queued for GC.")
    return m


def cmd_mirror_scan(registry_url, Port, org, username=None, password=None,
                    token=None, only_problems=False, max_repos=0, offset=0):
    """
    Per-repo mirror inventory for an org, plus the two aggregate views that the
    synthese asks SQL for (5.9 n1 = perimeter/host, n2 = health) but obtained
    through the API. Repos without a mirror return 404 and are counted separately.
    """
    repos, pages, truncated = quay_list_org_repos(
        registry_url, Port, org, username, password, token)
    total_found = len(repos)
    if offset:
        repos = repos[offset:]
    if max_repos:
        repos = repos[:max_repos]
    print("# org=%s  scanned=%d/%d (offset=%d)  pages=%d%s"
          % (org, len(repos), total_found, offset, pages,
             "  (ENUM TRUNCATED)" if truncated else ""))
    print("%-46s %-10s %-9s %-6s %-3s  %s"
          % ("REPOSITORY", "SYNC", "RETRIES", "ENABLE", "TM", "EXTERNAL_REFERENCE / ROBOT"))
    hosts, health, robots, nomirror, err = {}, {}, {}, [], 0
    for full in sorted(repos):
        apipath = "/api/v1/repository/" + quote(full, safe='/') + "/mirror"
        r = api_get(registry_url, Port, apipath, username, password, token)
        if r.status_code == 404:
            nomirror.append(full)
            continue
        if r.status_code != 200:
            err += 1
            continue
        try:
            m = r.json()
        except ValueError:
            err += 1
            continue
        st = str(m.get("sync_status"))
        ref = m.get("external_reference") or ""
        host = ref.split("/")[0] if ref else "-"
        hosts[host] = hosts.get(host, 0) + 1
        health[st] = health.get(st, 0) + 1
        rb = m.get("robot_username") or "-"
        robots[rb] = robots.get(rb, 0) + 1
        bad = st not in ("SUCCESS",)
        if only_problems and not bad:
            continue
        print("%-46s %-10s %-9s %-6s %-3s  %s"
              % (full[:46], st, m.get("sync_retries_remaining"),
                 m.get("is_enabled"), m.get("mirror_type"), (ref or "-")[:60]))
        print("%-46s   robot=%s  next_sync(sync_start)=%s  lease=%s  skopeo_timeout=%s"
              % ("", rb, m.get("sync_start_date"), m.get("sync_expiration_date"),
                 m.get("skopeo_timeout_interval", m.get("skopeo_timeout"))))
    print()
    print("# HEALTH  " + "  ".join("%s=%d" % (k, v) for k, v in
                                   sorted(health.items(), key=lambda x: -x[1]))
          + "  | no-mirror=%d error=%d" % (len(nomirror), err))
    print("# PERIMETRE (external_reference host)  "
          + "  ".join("%s=%d" % (k, v) for k, v in
                      sorted(hosts.items(), key=lambda x: -x[1])))
    print("# ROBOTS  " + "  ".join("%s=%d" % (k, v) for k, v in
                                   sorted(robots.items(), key=lambda x: -x[1])))
    if nomirror:
        print("# WITHOUT MIRROR (first 30): " + ", ".join(nomirror[:30]))
        if len(nomirror) > 30:
            print("   ... %d more" % (len(nomirror) - 30))
    return


