def get_blob(registry_url, username, password,Port,token,imageName,digest):
    found=0
    blob=""

    for blob_type in [ 'application/vnd.docker.container.image.v1+json',
                       'application/vnd.docker.image.rootfs.diff.tar.gzip',
                       'application/octet-stream'
                      ]:

        headers =    {
            'Content-Type': 'application/json',
            'Accept': blob_type,
            'Authorization': "Bearer "+token
        }
        url="https://"+registry_url+":"+Port+"/v2/"+imageName+"/blobs/"+digest
        response = requests.get(url, headers=headers)
        if response.status_code == 200 and response.headers['Content-Type'] == blob_type and found==0:
            blob=response.text
            found=1
            break
        
    if (found == 0):
        print("Failed to get blob, status_code: %d header: %s, manifestReturned: %s" % ( response.status_code, response.headers, response.text))
    return(blob)



def get_manifestlist(registry_url, username, password,Port,token,imageName,digest):
    if debug:
        printstderr("# get_manifestlist")
    # FIX: advertise every accepted media type in ONE Accept header. The old
    # loop issued up to 4 GETs (and re-downloaded the manifest each time) just
    # to discover its type, which made expanding a tag painfully slow.
    headers =    {
        'Content-Type': 'application/json',
        'Accept': MANIFEST_ACCEPT
    }
    if token:
        headers['Authorization'] = "Bearer "+token
    url="https://"+registry_url+":"+Port+"/v2/"+imageName+"/manifests/"+digest
    if debug:
        log_python_request_curl_transform("GET",url,headers)
    response = _http_session().get(url, headers=headers, timeout=40)
    content_type = response.headers.get('Content-Type', '').split(';')[0].strip()
    if response.status_code == 200:
        if content_type in MANIFEST_MEDIA_TYPES:
            return response.text
        # Some registries answer a valid manifest with a generic Content-Type;
        # accept it rather than failing after a 200.
        try:
            if json.loads(response.text).get("schemaVersion") == 2:
                return response.text
        except (ValueError, AttributeError):
            pass

    printstderr("Failed to get images, status_code: %d header: %s, manifestReturned: %s" % (
        response.status_code, response.headers, content_type or response.text[:120]))
    return None



def get_manifest_list_image_digest(registry_url, username, password,Port,token,imageName,tag):
    if debug:
        printstderr("# get_manifestlist")
    # FIX: same as get_manifestlist: a HEAD with the combined Accept header
    # resolves the digest in one round trip instead of four.
    headers =    {
        'Accept': MANIFEST_ACCEPT
    }
    if token:
        headers['Authorization'] = "Bearer "+token
    url="https://"+registry_url+":"+Port+"/v2/"+imageName+"/manifests/"+tag
    if debug:
        log_python_request_curl_transform("HEAD",url,headers)

    response = _http_session().head(url, headers=headers, timeout=20)
    digest = response.headers.get("Docker-Content-Digest")
    if response.status_code == 200 and digest:
        return digest

    content_type = response.headers.get('Content-Type', '').split(';')[0].strip()
    printstderr(
        "Failed to get digest: status_code=%s headers=%s content_types_seen=%s"
        % (response.status_code, response.headers, content_type)
    )
    return None


def getToken(registry_url, username, password,Port):
    token=None
    # FIX: was auth=(username,password) -> requests encodes Basic with LATIN-1;
    # a password with any non-ASCII byte then differs from what podman/docker
    # send (UTF-8) and Quay answers 401 'Invalid username or password'.
    headers = { 'Content-Type': 'application/json', 'Accept': 'application/json',
                'Authorization': basic_header(username, password) }
    # FIX: Quay advertises service="<host>" WITHOUT the port in WWW-Authenticate.
    # Appending ":"+Port made the token request mismatch the advertised service.
    options=  {'account': username , 'service' : registry_url }

    options_urlencoded=urlencode(options)
    url=_base_url(registry_url,Port)+"/v2/auth?"+options_urlencoded
    if debug:
        # SECURITY: never echo the raw URL -- it carries account=<login>, which
        # IS a credential on a robot/LDAP account. Mask every query value.
        safe_url = re.sub(r'(account|service|scope)=([^&]*)',
                          lambda m: "%s=<masked:%d>" % (m.group(1), len(m.group(2))),
                          url)
        printstderr("# token request: " + safe_url)
    response = _http_session().get(url, headers=headers, timeout=25)
    if response.status_code == 200:
       json_token = json.loads(response.text)
       token=json_token["token"]
    else:
        # FIX: the original printed only 'Can not get a token' -- useless.
        printstderr("Can not get a token (HTTP %d): %s" % (response.status_code,
                    (response.text or '')[:160].replace('\n',' ')))
        if response.status_code in (401, 403):
            printstderr("  -> the credential itself is refused by the registry.")
            printstderr("     Verify with: podman login <registry>   (or export QRC_TOKEN=...)")
        sys.exit(3)
    return token

def _get_anonymous_token(registry_url, Port, scope=None, timeout=25):
    """Try the anonymous token grant.

    Public registries commonly answer /v2/auth without any Authorization
    header and issue a pull token (Quay does this for public repositories).
    Returns (token, ttl) or (None, 0); never raises, so callers can fall back
    to a plain unauthenticated request.
    """
    options = {'service': registry_url}
    if scope:
        options['scope'] = scope
    url = _base_url(registry_url, Port) + "/v2/auth?" + urlencode(options)
    if debug:
        printstderr("# anonymous token request (no credentials)")
    try:
        response = _http_session().get(url, headers={'Accept': 'application/json'},
                                       timeout=timeout)
        if response.status_code == 200:
            data = response.json()
            token = data.get("token") or data.get("access_token")
            try:
                ttl = float(data.get("expires_in", 300))
            except (TypeError, ValueError):
                ttl = 300.0
            if token:
                return token, ttl
    except Exception:
        pass
    return None, 0


def getTokenForImageScope(registry_url, username, password,Port,imageName,anonymous=False):
    token=None
    cache_key=(registry_url, str(Port), imageName, None if anonymous else username)
    cached=scope_token_cache.get(cache_key)
    if cached and cached[1] > time.time():
        return cached[0]
    if anonymous:
        token, ttl = _get_anonymous_token(
            registry_url, Port, scope='repository:'+imageName+':pull')
        if token and ttl > 60:
            if len(scope_token_cache) > 512:
                scope_token_cache.clear()
            scope_token_cache[cache_key]=(token, time.time()+ttl-30)
        return token
    # FIX: same latin-1 Basic-auth bug as getToken().
    headers = { 'Content-Type': 'application/json', 'Accept': 'application/json',
                'Authorization': basic_header(username, password) }
    # FIX: same service bug as getToken() — no port in the advertised service.
    options=  {'account': username , 'service' : registry_url, 'scope':'repository:'+imageName+':pull' }

    options_urlencoded=urlencode(options)
    url=_base_url(registry_url,Port)+"/v2/auth?"+options_urlencoded
    response = _http_session().get(url, headers=headers, timeout=25)
    if response.status_code == 200:
       json_token = json.loads(response.text)
       token=json_token["token"]
       # Cache the token so browsing a repo does not re-request it for its
       # tags, its digest and every manifest. Default to 5 min when the
       # registry does not report expires_in; refresh 30 s early.
       try:
           ttl=float(json_token.get("expires_in", 300))
       except (TypeError, ValueError):
           ttl=300.0
       if ttl > 60:
           if len(scope_token_cache) > 512:
               scope_token_cache.clear()
           scope_token_cache[cache_key]=(token, time.time()+ttl-30)
    else:
        printstderr("Can not get a token for scope repository:%s:pull (HTTP %d): %s" % (
            imageName, response.status_code, (response.text or '')[:160].replace('\n',' ')))
        sys.exit(3)
    return token
 
