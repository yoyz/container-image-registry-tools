def mask_value(v):
    return "[REDACTED:%d chars]" % (len(v) if hasattr(v, "__len__") else 1)


def redact(obj, _key=""):
    """Recursively redact secrets so nothing sensitive ever reaches stdout."""
    if isinstance(obj, dict):
        out = {}
        for k, v in obj.items():
            if not SHOW_SECRETS and isinstance(k, str) and (
                    SECRET_KEY_RX.search(k) or k in CRED_FIELDS):
                out[k] = mask_value(v)
            else:
                out[k] = redact(v, k if isinstance(k, str) else "")
        return out
    if isinstance(obj, list):
        return [redact(x, _key) for x in obj]
    return obj


def print_api_response(response):
    """
    fork: print an API response WITHOUT leaking secrets. JSON answers are
    redacted (SECRET_KEY_RX + CRED_FIELDS) and pretty-printed; anything else
    (HTML error page, empty body) is printed as-is. Opt-out: --show-secrets.
    """
    try:
        print(json.dumps(redact(response.json()), indent=2))
    except ValueError:
        print(response.text)


def _base_url(registry_url, Port):
    # FIX: do NOT append :443 — it is the default https port and putting it in
    # the URL makes Quay answer 308 redirects that then break auth follow-up.
    p = str(Port)
    if p in ("443", "None", ""):
        return "https://" + registry_url
    return "https://" + registry_url + ":" + p


RAW_BASIC = None      # fork: stored base64 replayed VERBATIM, exactly like podman
CREDS_FROM_STORE = False  # True once credentials were auto-loaded from a file
ALLOW_STORE_WEB_LOGIN = (os.environ.get("QRC_ALLOW_STORE_WEB_LOGIN", "1")
                         .strip().lower() not in ("0", "false", "no"))


def basic_header(username, password):
    """
    fork FIX (root cause of 'Can not get a token' while `podman search` works):
    1) requests' HTTPBasicAuth encodes with LATIN-1, so a password holding a
       non-ASCII byte yields different bytes than podman's UTF-8 -> 401.
    2) Worse: the store may not hold 'login:password' at all (OAuth identity
       token, robot token, helper placeholder). Splitting it on ':' INVENTS a
       credential. podman never splits -- it replays the stored base64 verbatim.
    So: if we captured the stored blob, send it byte-identical; else encode
    UTF-8 explicitly.
    """
    if RAW_BASIC:
        return "Basic " + RAW_BASIC
    raw = ("%s:%s" % (username, password or "")).encode("utf-8")
    return "Basic " + base64.b64encode(raw).decode("ascii")



def _http_session():
    """Return a thread-local requests.Session, or a fresh one when disabled."""
    if not PERSIST_CONNECTION:
        return requests.Session()
    session = getattr(_HTTP_THREAD_LOCAL, "session", None)
    if session is None:
        session = requests.Session()
        _HTTP_THREAD_LOCAL.session = session
    return session


def api_get(registry_url, Port, apipath, username=None, password=None,
            token=None, params=None, timeout=30, max_redirects=5, public=False):
    """
    Single authenticated GET on the Quay API. GET only — no verb override.
    FIX: follow redirects. Quay 3.16 answers 308 to normalize missing trailing
    slashes (e.g. /api/v1/user -> /api/v1/user/); forcing allow_redirects=False
    broke every such endpoint.
    Redirects here stay on the same host, so the auth header is kept; a redirect
    that LEAVES the host is refused instead of leaking credentials.
    """
    url = _base_url(registry_url, Port) + apipath
    # /api/v1 accepts ONLY an app/OAuth token, a session cookie, or a web-login
    # session (the mode the Ansible collection uses) -- never HTTP Basic.
    # FIX: `public=True` skips that gate: endpoints like GET /config answer
    # anonymously and must NOT be blocked (they were, in an earlier revision
    # of this fork -- a self-inflicted regression caught in review).
    if public:
        hdrs = {'Accept': 'application/json'}
    else:
        hdrs = api_headers_for(token, username, password, registry_url, Port)
        if hdrs is None:
            explain_api_auth_needed(registry_url)
            r = _NoAuthResult()
            return r
    # Session reuse: a web-login session carries its cookie (and CSRF token)
    # inside SESSION; token/cookie/anonymous modes use a fresh session.
    if SESSION is not None and 'Authorization' not in hdrs and 'Cookie' not in hdrs and not public:
        sess = SESSION
        hdrs = dict(hdrs)
        if CSRF:
            hdrs['X-CSRF-Token'] = CSRF
    else:
        sess = _http_session()
    r = None
    for _ in range(max_redirects):
        # requests.Session is not documented as thread-safe, and gc-audit
        # --all-repos can audit several repositories concurrently when using
        # the web-login session.  Serialize only the shared-session request;
        # token/cookie/anonymous modes use a per-call Session and stay parallel.
        if sess is SESSION:
            with SESSION_LOCK:
                r = sess.get(url, headers=hdrs, params=params, timeout=timeout,
                             allow_redirects=False)
        else:
            r = sess.get(url, headers=hdrs, params=params, timeout=timeout,
                         allow_redirects=False)
        if r.status_code in (301, 302, 303, 307, 308):
            loc = r.headers.get("Location", "")
            if not loc:
                break
            from urllib.parse import urljoin, urlparse
            nxt = urljoin(url, loc)
            if urlparse(nxt).hostname != urlparse(url).hostname:
                printstderr("** refusing cross-host redirect %s -> %s (credential leak guard)"
                            % (url, nxt))
                return r
            if debug:
                printstderr("# follow %d -> %s" % (r.status_code, nxt))
            url, params = nxt, None
            continue
        break
    if debug:
        printstderr("# GET %s [%d]" % (r.url if r is not None else url,
                                       r.status_code if r is not None else 0))
    return r


def describe_response(r, what=""):
    """Human-readable status, so a 401/404 never looks like 'empty registry'."""
    if r.status_code == 0:
        # api_get() short-circuited: the reason was already explained. No dup.
        return False
    if r.status_code == 200:
        return True
    hint = {
        401: "NOT AUTHENTICATED -> provide credentials (config.json, -u/-p or -T token)",
        403: "FORBIDDEN -> authenticated but insufficient rights on this object",
        404: "NOT FOUND -> object has no mirror config (or wrong org/repo)",
        302: "REDIRECT -> likely an auth wall",
    }.get(r.status_code, "unexpected status")
    printstderr("** HTTP %d on %s : %s" % (r.status_code, what or r.url, hint))
    body = (r.text or "").strip().replace("\n", " ")
    if body:
        printstderr("   body: " + body[:200])
    return False


def repo_full_name(entry):
    """/api/v1/repository entries differ in shape between Quay versions."""
    if "repository" in entry:
        return entry["repository"]
    ns, name = entry.get("namespace"), entry.get("name")
    if ns and name:
        return ns + "/" + name
    return None


def quay_list_org_repos(registry_url, Port, org, username=None, password=None,
                        token=None, page_limit=200):
    """
    Enumerate the repositories of an org. THIS is how you enumerate a Quay:
    /v2/_catalog returns [] on Quay unless you are a superuser.
    Follows next_page fully (the Ansible role caps at 10 pages -- see synthese 8.6).
    """
    repos, pages = [], 0
    params = {"namespace": org}
    nxt = None
    while True:
        pages += 1
        if nxt:
            params["next_page"] = nxt
        r = api_get(registry_url, Port, "/api/v1/repository", username, password,
                    token, params=params)
        if not describe_response(r, "/api/v1/repository?namespace=%s (page %d)" % (org, pages)):
            return repos, pages, True
        try:
            data = r.json()
        except ValueError:
            printstderr("** non-JSON answer on page %d" % pages)
            return repos, pages, True
        for e in data.get("repositories", []):
            full = repo_full_name(e)
            if full:
                repos.append(full)
        nxt = data.get("next_page")
        if not nxt:
            return repos, pages, False
        if pages >= page_limit:                      # safety net, but way above 10
            printstderr("** page_limit %d reached for org %s -- list may be TRUNCATED"
                        % (page_limit, org))
            return repos, pages, True
        params = {"namespace": org}


