def getservercertificate(registry_url, Port):
    try:
        # 1. Setup context to ignore validation so we can grab the certs anyway
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE

        pem_chain = []

        # 3. Connect and wrap the socket
        with socket.create_connection((registry_url, int(Port)), timeout=10) as sock:
            with context.wrap_socket(sock, server_hostname=registry_url) as ssock:

                # 4. get_unverified_chain() only exists on Python 3.10+, where it
                #    returns the full chain. On older 3.x fall back to the leaf
                #    certificate exposed by getpeercert().
                get_chain = getattr(ssock, "get_unverified_chain", None)
                if get_chain is not None:
                    chain = get_chain()
                    if not chain:
                        printstderr(f"No certificates returned by {registry_url}:{Port}.")
                        return None
                else:
                    der_cert = ssock.getpeercert(binary_form=True)
                    if not der_cert:
                        printstderr(f"No certificate returned by {registry_url}:{Port}.")
                        return None
                    printstderr("Note: full chain unavailable (Python < 3.10), showing leaf certificate only.")
                    chain = [der_cert]

                # Convert each DER certificate in the chain to PEM
                for cert in chain:
                    pem_cert = ssl.DER_cert_to_PEM_cert(cert)
                    pem_chain.append(pem_cert)

        cert_pem = "\n".join(pem_chain)

        print(cert_pem)

        if checkhttpsconnection(registry_url,Port)==0:
            printstderr("You might want to add it to your system trust store by adding it to")
            printstderr("/etc/pki/ca-trust/source/anchors/")
            printstderr("and running 'sudo update-ca-trust'")
        else:
            printstderr("This server certificate is trusted locally.")
        return cert_pem

    except Exception as e:
        # 6. Catch the actual exception 'e' so you know exactly what broke
        printstderr(f"Error: Could not retrieve certificates from {registry_url} on port {Port}.")
        printstderr(f"Details: {e}")
        sys.exit(1)

def checkhttpsconnection(registry_url, port):
    global ssl_already_verified
    key = (registry_url, str(port))
    if key in ssl_already_verified:
        return 1 if ssl_already_verified[key] else 0
    try:
        requests.get("https://"+registry_url+":"+str(port) , timeout=5)
        ssl_already_verified[key] = True
        return 1
    except requests.exceptions.SSLError:
        printstderr("The server certificate is NOT trusted locally.")
        ssl_already_verified[key] = False
        return 0
    except requests.exceptions.RequestException as e:
        printstderr(f"An unrelated error occurred: {e}")
        ssl_already_verified[key] = False
        return 0
    

def log_python_request_curl_transform(method, url, headers, data=None):
    # SECURITY FIX (fork): the original interpolated the FULL Authorization
    # header -- a live Bearer token (measured here: 966 chars) -- into STDOUT.
    # That leaks the credential into terminal scrollback, any tee/> redirect and
    # any CI log, and pollutes the command's own data output. Mask + go to stderr.
    _auth = (headers or {}).get('Authorization', '')
    _kind, _, _val = _auth.partition(' ')
    _masked = ('%s <masked:%d chars>' % (_kind or 'Basic', len(_val))) if _auth else 'none'
    curl_cmd = 'curl -X %s %r -H "Accept: application/json" -H "Authorization: %s"' % (
        method, url, _masked)
    if data:
        curl_cmd += " -d '%s'" % re.sub(
            r'((?:password|secret|token|credential|api_key)"\s*:\s*")[^"]*"',
            r'\1[MASKED]"', str(data))
    printstderr('# ' + curl_cmd)   # STDERR: stdout must stay pure data
    #response = requests.request(method, url, headers=headers, data=data)
    #return response
    
    
